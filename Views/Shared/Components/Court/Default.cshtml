@model IEnumerable<PickleballClub.Models.TbCourt>

@foreach (var court in Model)
{
    var isIndoor = court.CourtType == "Indoor";
    var hourlyPrice = court.BasePrice + court.Surcharge;
    <div class="match-card">
        <div class="match-card-media">
            <div class="match-card-top">
                <span class="badge" style="background:rgba(17,24,39,0.76);color:#FFF;backdrop-filter:blur(6px);">
                    @(isIndoor ? "Trong nhà VIP" : "Ngoài trời")
                </span>
                <span class="match-live-badge" style="background:rgba(17,24,39,0.78);color:#F3F4F6;">Đang đồng bộ...</span>
            </div>
            <div>
                <h3 style="font-family:var(--font-display);font-size:1.35rem;font-weight:700;">@court.CourtName</h3>
                <p style="font-size:0.82rem;color:#E2E8F0;">@court.TypeLabel · Mặt sân @((court.Surface ?? "Acrylic Cushion 8 lớp").Replace("USAPA ", "").Replace("USAPA", "").Trim())</p>
            </div>
        </div>
        <div class="match-card-body">
            <div class="court-status-callout is-free">
                <div>
                    <div class="text-xs text-muted">Tình trạng khung giờ</div>
                    <div style="font-weight:600;font-size:0.88rem;color:var(--text-secondary);">Đang kiểm tra lịch trống từ máy chủ...</div>
                </div>
                <span class="badge badge-neutral">Đang tải</span>
            </div>
            <div class="match-card-footer">
                <div>
                    <span class="text-xs text-muted" style="display:block;">Giá thuê từ</span>
                    <strong class="text-mono tabular-nums" style="font-size:1.12rem;color:var(--brand-primary);">@hourlyPrice.ToString("N0") đ<span style="font-size:0.8rem;color:var(--text-secondary);font-weight:500;"> / giờ</span></strong>
                </div>
                <a href="/Booking?court=@court.CourtId" class="btn btn-primary btn-sm">
                    <span>Đặt sân này</span>
                </a>
            </div>
        </div>
    </div>
}
