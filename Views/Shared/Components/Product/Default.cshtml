@model IEnumerable<PickleballClub.Models.TbProduct>

@foreach (var p in Model)
{
    <div class="card">
        <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
            <div style="display:flex;align-items:center;gap:0.85rem;">
                <div class="stat-icon" style="background:var(--color-primary-50);color:var(--color-primary);">
                    @Html.Raw(p.Icon ?? "<iconify-icon icon='mdi:cup-water' width='24'></iconify-icon>")
                </div>
                <div>
                    <div class="font-bold">@p.Title</div>
                    <div class="text-xs text-muted">@(p.Description ?? "Phục vụ tận sân thi đấu")</div>
                </div>
            </div>
            <div style="text-align:right;">
                <div class="font-bold text-mono" style="color:var(--color-primary);">@((p.Price ?? 0).ToString("N0")) đ</div>
                <span class="badge badge-success">Còn hàng (@(p.UnitInStock ?? 100))</span>
            </div>
        </div>
    </div>
}
