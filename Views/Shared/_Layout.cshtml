@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PickleballClub.Services.ClubSettingsService ClubSettingsService
@inject PickleballClub.Models.PickleballContext SsrDb
@{
    var csrfTokens = Antiforgery.GetAndStoreTokens(Context);
    var ssrSettings = await ClubSettingsService.GetSettingsAsync(SsrDb);
    var ssrVipSurcharge = await SsrDb.TbCourts.AsNoTracking()
        .Where(c => c.IsActive && c.Surcharge > 0)
        .Select(c => c.Surcharge)
        .FirstOrDefaultAsync();
    if (ssrVipSurcharge <= 0) ssrVipSurcharge = 20000;
    var vndFmt = new System.Globalization.NumberFormatInfo { NumberGroupSeparator = "." };
    string ssrStdPriceNum = ssrSettings.BaseCourtPrice.ToString("#,0", vndFmt);
    string ssrPeakTotalNum = (ssrSettings.BaseCourtPrice + ssrSettings.PeakSurchargePerHour).ToString("#,0", vndFmt);
    string ssrVipNum = "+" + ssrVipSurcharge.ToString("#,0", vndFmt);
    string ssrAddress = ssrSettings.RawCms.TryGetValue("address", out var addrVal) && !string.IsNullOrWhiteSpace(addrVal)
        ? addrVal
        : "Khu Thảo Điền, TP. Thủ Đức, TP.HCM";
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="@csrfTokens.RequestToken">
    <title>@(ViewData["Title"] ?? "Spike Pickleball Club — Hệ Thống Đặt Sân & Pro Shop")</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF5520'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23FFFFFF'/%3E%3C/svg%3E">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('spike_theme');
                if (savedTheme === 'dark' || savedTheme === 'light') {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                    document.documentElement.classList.toggle('dark', savedTheme === 'dark');
                }
            } catch (_) {}
        })();
    </script>
    @await Html.PartialAsync("_DesignSystemCss")
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>
<body>
    <a href="#mainContent" class="sr-only">Chuyển tới nội dung chính</a>

    <header class="site-header">
        <div class="site-header-inner">
            <a href="/" class="site-brand">
                <div class="site-brand-mark">
                    <iconify-icon icon="mdi:racquetball" width="20"></iconify-icon>
                </div>
                <div class="site-brand-text">
                    <span class="site-brand-name">SPIKE<span>.</span></span>
                    <span class="site-brand-tag">Pickleball Club</span>
                </div>
            </a>

            <nav class="site-nav" id="siteMainNav" aria-label="Điều hướng chính">
                @await Component.InvokeAsync("MenuTop")
            </nav>

            <div class="site-header-actions">
                <div id="headerAuthActionsMount">
                    @if (Function.IsLogin())
                    {
                        var initials = string.IsNullOrWhiteSpace(Function._FullName) ? "U" : Function._FullName.Trim().Substring(0, 1).ToUpperInvariant();
                        <div style="display:inline-flex;align-items:center;gap:6px;">
                            <a href="/Account/Profile" class="sn-nav-user" title="Hồ sơ cá nhân">
                                <span class="sn-nav-user-badge">@initials</span>
                                <span class="sn-nav-user-text">@Function._FullName</span>
                            </a>
                            <a href="/Account/Logout" class="btn btn-xs btn-ghost" title="Đăng xuất">Thoát</a>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-sm btn-secondary">Đăng nhập</a>
                    }
                </div>
                <button type="button"
                        class="sh-site-theme-btn"
                        id="siteThemeToggleBtn"
                        onclick="toggleSpikeTheme()"
                        aria-label="Chuyển đổi giao diện Sáng / Tối"
                        title="Chuyển đổi giao diện Sáng / Tối">
                    <iconify-icon icon="lucide:sun" width="16" class="sh-theme-icon-sun"></iconify-icon>
                    <iconify-icon icon="lucide:moon" width="16" class="sh-theme-icon-moon"></iconify-icon>
                </button>
                @if (Function.IsLogin() && (Function._RoleId == 1 || Function._RoleId == 3))
                {
                    <a href="/Admin" class="sn-nav-admin-link sh-public-admin-link" title="Mở Trung tâm Quản trị">
                        <iconify-icon icon="lucide:layout-dashboard" width="14"></iconify-icon>
                        <span>Quản trị</span>
                    </a>
                }
                <a href="/Booking" class="btn btn-primary btn-sm header-cta-book">Đặt sân ngay</a>
                <button type="button"
                        id="siteMobileNavBtn"
                        class="sn-mobile-menu-btn mobile-menu-btn"
                        onclick="toggleMobileNav()"
                        aria-expanded="false"
                        aria-controls="siteMainNav"
                        aria-label="Mở menu điều hướng">
                    <iconify-icon icon="lucide:menu" width="19"></iconify-icon>
                </button>
            </div>
        </div>
    </header>

    <div id="adminSubbarMount"></div>

    <div id="mainContent">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <div class="site-footer-grid">
            <div class="site-footer-col">
                <a href="/" class="site-brand" style="margin-bottom:12px;">
                    <div class="site-brand-mark">
                        <iconify-icon icon="mdi:racquetball" width="18"></iconify-icon>
                    </div>
                    <div class="site-brand-text">
                        <span class="site-brand-name">SPIKE<span>.</span></span>
                        <span class="site-brand-tag">Pickleball Club</span>
                    </div>
                </a>
                <p style="font-size:0.875rem;line-height:1.65;color:var(--text-secondary);margin:0;">
                    Tổ hợp sân thi đấu Pickleball trong nhà và ngoài trời với mặt sân Cushion 8 lớp, hệ thống đèn chống chói và Pro Shop ngay tại sảnh.
                </p>
            </div>

            <div class="site-footer-col">
                <h4>Khám phá CLB</h4>
                <div class="site-footer-links">
                    <a href="/">Trang chủ &amp; Lịch trống</a>
                    <a href="/Booking">Đặt sân trực tuyến</a>
                    <a href="/Product">Cửa hàng Pro Shop</a>
                    <a href="/Lookup">Tra cứu mã vé QR</a>
                </div>
            </div>

            <div class="site-footer-col">
                <h4>Bảng giá niêm yết</h4>
                <div class="site-footer-links">
                    <span>Tiêu chuẩn (<span data-cms="openTime">@ssrSettings.OpenTime</span> – <span data-cms="peakStart">@ssrSettings.PeakStart</span>): <strong style="color:var(--text-primary);" class="tabular-nums" data-cms-price="courtPrice" data-cms="courtPriceFormatted">@ssrStdPriceNum đ/h</strong></span>
                    <span>Giờ vàng (<span data-cms="peakStart">@ssrSettings.PeakStart</span> – <span data-cms="closeTime">@ssrSettings.CloseTime</span>): <strong style="color:var(--brand-primary-ink);" class="tabular-nums" data-cms-peak-total="true">@ssrPeakTotalNum đ/h</strong></span>
                    <span>Phụ thu sân VIP: <strong style="color:var(--text-primary);" class="tabular-nums" data-cms="vipSurchargeFormatted">@ssrVipNum đ/h</strong></span>
                    <span>Giờ hoạt động: <strong style="color:var(--text-primary);" class="tabular-nums" data-cms="openHours">@ssrSettings.OpenTime – @ssrSettings.CloseTime</strong></span>
                </div>
            </div>

            <div class="site-footer-col">
                <h4>Liên hệ CLB</h4>
                <div class="site-footer-links">
                    <span style="display:inline-flex;align-items:flex-start;gap:7px;">
                        <iconify-icon icon="lucide:map-pin" width="15" style="color:var(--brand-primary);margin-top:3px;flex-shrink:0;"></iconify-icon>
                        <span data-cms="address">@ssrAddress</span>
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:7px;">
                        <iconify-icon icon="lucide:phone" width="15" style="color:var(--brand-primary);flex-shrink:0;"></iconify-icon>
                        <span>Hotline: <strong style="color:var(--text-primary);" class="tabular-nums" data-cms="hotline">@ssrSettings.Hotline</strong></span>
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:7px;">
                        <iconify-icon icon="lucide:mail" width="15" style="color:var(--brand-primary);flex-shrink:0;"></iconify-icon>
                        <span>contact@spikepickleball.vn</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="site-footer-bottom">
            <span>© 2026 Spike Pickleball Club. Bảo lưu mọi quyền.</span>
            <span>Mặt sân Cushion 8 lớp &amp; Đặt sân mã QR định chuẩn</span>
        </div>
    </footer>

    @if (Function.IsLogin())
    {
        var roleKey = Function._RoleId == 1 ? "admin" : (Function._RoleId == 3 ? "staff" : "user");
        var roleLabel = Function._RoleId == 1 ? "Ban Quản Trị CLB" : (Function._RoleId == 3 ? "Nhân viên Vận hành" : "Hội viên CLB");
        <script>
            window.SERVER_AUTH_USER = {
                id: @Function._AccountId,
                name: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Function._FullName) ? "Hội viên" : Function._FullName)),
                email: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Email)),
                phone: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Phone)),
                skillLevel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._SkillLevel)),
                role: '@roleKey',
                roleLabel: '@Html.Raw(roleLabel)',
                avatar: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Function._Avatar))
            };
            try { localStorage.removeItem('pb_auth_user'); } catch (_) {}
        </script>
    }
    else
    {
        <script>
            window.SERVER_AUTH_USER = null;
            try { localStorage.removeItem('pb_auth_user'); } catch (_) {}
        </script>
    }
    <script src="~/js/shared.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
