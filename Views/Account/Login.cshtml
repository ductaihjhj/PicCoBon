@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PickleballClub.Models.PickleballContext SsrDb
@inject PickleballClub.Services.RegistrationOtpService RegOtpService
@{
    ViewData["Title"] = "Đăng nhập & Đăng ký Hội viên — Spike OS";
    var serverAuthError = TempData["AuthError"] as string;
    var serverRegisterError = TempData["RegisterError"] as string;
    var serverRegisterInfo = TempData["RegisterInfo"] as string;
    bool serverRegisterVerified = string.Equals(TempData["RegisterVerified"] as string, "true", StringComparison.OrdinalIgnoreCase);
    var serverRegisterSuccessMsg = TempData["RegisterSuccessMessage"] as string;
    var pendingRegState = await RegOtpService.GetPendingSessionStateAsync(SsrDb, Context);
    int activeCourtCount = await SsrDb.TbCourts.AsNoTracking().CountAsync(c => c.IsActive);

    string initialOtpStateJson = JsonSerializer.Serialize(new
    {
        hasPending = pendingRegState.HasPending,
        verificationToken = pendingRegState.VerificationToken ?? string.Empty,
        maskedEmail = pendingRegState.MaskedEmail ?? string.Empty,
        expiresInSeconds = pendingRegState.ExpiresInSeconds,
        resendCooldownSeconds = pendingRegState.ResendCooldownSeconds,
        remainingAttempts = pendingRegState.RemainingAttempts,
        maxAttempts = pendingRegState.MaxAttempts,
        deliveryFailed = pendingRegState.DeliveryFailed,
        verifiedSuccess = serverRegisterVerified,
        verifiedMessage = serverRegisterSuccessMsg ?? string.Empty,
        registerError = serverRegisterError ?? string.Empty,
        registerInfo = serverRegisterInfo ?? string.Empty
    });
}

<main class="spk-auth-page">
    <div class="spk-auth-container">
        <div class="spk-auth-grid" id="authStageBox">
            <!-- Left Showcase Panel: Spike OS Soft Green Editorial Identity -->
            <div class="spk-auth-showcase">
                <div>
                    <img src="/assets/spike-logo.png" alt="Spike Pickleball Club" class="spk-auth-brand-logo" width="720" height="308" />
                    <div class="spk-auth-showcase-badge">
                        <iconify-icon icon="lucide:shield-check" width="15"></iconify-icon>
                        <span>@activeCourtCount SÂN TIÊU CHUẨN USAPA</span>
                    </div>
                    <h1 class="spk-auth-showcase-title">Nền Tảng Đặt Sân &amp; Hội Viên Thể Thao Hiện Đại</h1>
                    <p class="spk-auth-showcase-desc">
                        Đặt lịch trực tuyến theo ma trận @activeCourtCount sân trực tiếp, nhận vé QR ký số chống giả mạo và gộp hóa đơn Pro Shop vào ca thi đấu của bạn.
                    </p>

                    <div class="spk-auth-feature-list">
                        <div class="spk-auth-feature-item">
                            <span class="spk-auth-feature-icon">
                                <iconify-icon icon="lucide:calendar-check-2" width="16"></iconify-icon>
                            </span>
                            <div>
                                <strong style="display:block;color:#FFFFFF;margin-bottom:2px;">Đặt sân chống trùng giờ tức thì</strong>
                                <span style="color:rgba(234,247,238,0.82);font-size:0.8rem;">Tự động bóc tách khung giờ Tiêu chuẩn &amp; Giờ vàng chính xác tới từng phút.</span>
                            </div>
                        </div>
                        <div class="spk-auth-feature-item">
                            <span class="spk-auth-feature-icon">
                                <iconify-icon icon="lucide:qr-code" width="16"></iconify-icon>
                            </span>
                            <div>
                                <strong style="display:block;color:#FFFFFF;margin-bottom:2px;">Thẻ Check-in QR định danh</strong>
                                <span style="color:rgba(234,247,238,0.82);font-size:0.8rem;">Mã QR HMAC-SHA256 sắc nét, hỗ trợ tải ảnh PNG/SVG và quét nhanh tại quầy.</span>
                            </div>
                        </div>
                        <div class="spk-auth-feature-item">
                            <span class="spk-auth-feature-icon">
                                <iconify-icon icon="lucide:award" width="16"></iconify-icon>
                            </span>
                            <div>
                                <strong style="display:block;color:#FFFFFF;margin-bottom:2px;">Hồ sơ VĐV &amp; chỉ số DUPR</strong>
                                <span style="color:rgba(234,247,238,0.82);font-size:0.8rem;">Theo dõi lịch sử thi đấu, đơn hàng Pro Shop và thông số vợt cá nhân.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding-top:18px;border-top:1px solid rgba(255,255,255,0.16);font-size:0.78rem;color:rgba(234,247,238,0.85);">
                    <span>Bảo mật Cookie HttpOnly &amp; CSRF</span>
                    <span>Mở cửa 06:00 – 22:00 mỗi ngày</span>
                </div>
            </div>

            <!-- Right Form Panel: Clean Login / Register Switcher -->
            <div class="spk-auth-form-panel">
                <div class="spk-auth-tabs" role="tablist" aria-label="Chuyển đổi Đăng nhập và Đăng ký">
                    <button type="button" class="spk-auth-tab active" id="mobTabLogin" onclick="switchAuthMode('login')">
                        <iconify-icon icon="lucide:log-in" width="16"></iconify-icon>
                        <span>Đăng nhập</span>
                    </button>
                    <button type="button" class="spk-auth-tab" id="mobTabRegister" onclick="switchAuthMode('register')">
                        <iconify-icon icon="lucide:user-plus" width="16"></iconify-icon>
                        <span>Đăng ký Hội viên</span>
                    </button>
                </div>

                <!-- Active Session Notice -->
                <div id="activeSessionBanner" class="sn-alert sn-alert-success" style="display:none;margin-bottom:0;">
                    <span>Đang đăng nhập: <strong id="activeSessionName">---</strong> (<span id="activeSessionRole">---</span>)</span>
                    <div style="display:flex;gap:8px;align-items:center;">
                        <a href="/" class="btn btn-xs btn-secondary">Trang chủ</a>
                        <button type="button" onclick="logout()" class="btn btn-xs btn-danger">Thoát</button>
                    </div>
                </div>

                <!-- Redirect / Access Notice -->
                <div id="redirectAlert" class="sn-alert sn-alert-warning" style="display:none;margin-bottom:0;">
                    <iconify-icon icon="lucide:shield-alert" width="17"></iconify-icon>
                    <span id="redirectAlertText">Vui lòng đăng nhập để tiếp tục.</span>
                </div>

                <!-- PANEL 1: LOGIN FORM -->
                <div id="authPanelLogin" class="sign-in-panel">
                    <div style="margin-bottom:16px;">
                        <h2 id="authCardTitle" style="font-size:1.45rem;font-weight:800;margin-bottom:4px;">Chào mừng trở lại sân</h2>
                        <p class="text-sm text-muted">Nhập Email, Tên đăng nhập hoặc Số điện thoại hội viên để tiếp tục.</p>
                    </div>

                    <div id="loginErrorAlert" class="sn-alert sn-alert-danger" style="@(!string.IsNullOrEmpty(serverAuthError) ? "display:flex;" : "display:none;")">
                        <iconify-icon icon="lucide:alert-triangle" width="17"></iconify-icon>
                        <span id="loginErrorText">@(serverAuthError ?? "Thông tin đăng nhập chưa chính xác.")</span>
                    </div>

                    <form id="loginForm" onsubmit="handleFormLogin(event)" novalidate>
                        <div class="form-group" id="fieldWrapLoginEmail">
                            <label class="form-label" for="loginEmail">Email, Tên đăng nhập hoặc Số điện thoại *</label>
                            <div class="spk-auth-input-wrap">
                                <span class="spk-auth-input-icon"><iconify-icon icon="lucide:mail" width="17"></iconify-icon></span>
                                <input type="text"
                                       id="loginEmail"
                                       class="form-input"
                                       placeholder="VD: member@spike.vn hoặc 0901234567"
                                       autocomplete="username"
                                       oninput="clearFieldError('loginEmail')">
                            </div>
                            <span class="field-error-msg" id="loginEmailError">Vui lòng nhập Email hoặc SĐT hợp lệ (9–11 số).</span>
                        </div>

                        <div class="form-group" id="fieldWrapLoginPassword">
                            <label class="form-label" for="loginPassword">Mật khẩu bảo mật *</label>
                            <div class="spk-auth-input-wrap">
                                <span class="spk-auth-input-icon"><iconify-icon icon="lucide:lock" width="17"></iconify-icon></span>
                                <input type="password"
                                       id="loginPassword"
                                       class="form-input"
                                       placeholder="Nhập mật khẩu"
                                       autocomplete="current-password"
                                       oninput="clearFieldError('loginPassword')">
                                <button type="button" class="spk-pass-toggle" onclick="toggleAnimatedPassword('loginPassword', 'eyeIconLogin')" title="Hiện / Ẩn mật khẩu">
                                    <iconify-icon id="eyeIconLogin" icon="lucide:eye" width="17"></iconify-icon>
                                </button>
                            </div>
                            <span class="field-error-msg" id="loginPasswordError">Mật khẩu cần tối thiểu 6 ký tự.</span>
                        </div>

                        <div style="display:flex;align-items:center;justify-content:space-between;margin:6px 0 18px;font-size:0.8125rem;">
                            <label style="display:inline-flex;align-items:center;gap:7px;color:var(--text-secondary);cursor:pointer;">
                                <input type="checkbox" id="rememberMe" checked style="accent-color:var(--brand-primary);">
                                <span>Lưu phiên đăng nhập 30 ngày</span>
                            </label>
                            <a href="javascript:void(0)" onclick="openModal('forgotPasswordModal')" style="color:var(--brand-primary-ink);font-weight:700;">Quên mật khẩu?</a>
                        </div>

                        <button type="submit" id="btnSubmitLogin" class="btn btn-primary btn-lg btn-block">
                            <iconify-icon icon="lucide:log-in" width="18"></iconify-icon>
                            <span id="btnSubmitLoginText">Đăng nhập vào Sân Đấu</span>
                        </button>
                    </form>
                </div>

                <!-- PANEL 2: REGISTER & EMAIL OTP VERIFICATION -->
                <div id="authPanelRegister" class="sign-up-panel" style="display:none;">
                    <div id="registerErrorAlert" class="sn-alert sn-alert-danger" style="@(!string.IsNullOrEmpty(serverRegisterError) ? "display:flex;" : "display:none;")">
                        <iconify-icon icon="lucide:alert-triangle" width="17"></iconify-icon>
                        <span id="registerErrorText">@(serverRegisterError ?? "Vui lòng kiểm tra lại thông tin đăng ký.")</span>
                    </div>

                    <div id="registerInfoAlert" class="sn-alert sn-alert-success" style="@(!string.IsNullOrEmpty(serverRegisterInfo) ? "display:flex;" : "display:none;")">
                        <iconify-icon icon="lucide:mail-check" width="17"></iconify-icon>
                        <span id="registerInfoText">@(serverRegisterInfo ?? "")</span>
                    </div>

                    <!-- STEP 2A: REGISTRATION DETAILS FORM -->
                    <div id="regStepForm" style="@(pendingRegState.HasPending || serverRegisterVerified ? "display:none;" : "display:block;")">
                        <div style="margin-bottom:14px;">
                            <h2 style="font-size:1.45rem;font-weight:800;margin-bottom:4px;">Tạo Tài Khoản Hội Viên</h2>
                            <p class="text-sm text-muted">Điền thông tin và xác minh email chính chủ để kích hoạt thẻ hội viên CLB.</p>
                        </div>

                        <form id="registerForm" action="/Account/Register" method="post" onsubmit="handleFormRegister(event)" novalidate>
                            @Html.AntiForgeryToken()
                            <div class="form-row">
                                <div class="form-group" id="fieldWrapRegFullName">
                                    <label class="form-label" for="regFullName">Họ và tên *</label>
                                    <div class="spk-auth-input-wrap">
                                        <span class="spk-auth-input-icon"><iconify-icon icon="lucide:user" width="16"></iconify-icon></span>
                                        <input type="text" id="regFullName" name="FullName" class="form-input" placeholder="Nguyễn Văn A" autocomplete="name" oninput="clearFieldError('regFullName')">
                                    </div>
                                    <span class="field-error-msg" id="regFullNameError">Nhập tối thiểu 2 ký tự.</span>
                                </div>

                                <div class="form-group" id="fieldWrapRegPhone">
                                    <label class="form-label" for="regPhone">Số điện thoại *</label>
                                    <div class="spk-auth-input-wrap">
                                        <span class="spk-auth-input-icon"><iconify-icon icon="lucide:phone" width="16"></iconify-icon></span>
                                        <input type="tel" id="regPhone" name="Phone" class="form-input" placeholder="0901234567" autocomplete="tel" oninput="clearFieldError('regPhone')">
                                    </div>
                                    <span class="field-error-msg" id="regPhoneError">SĐT gồm 9–11 chữ số.</span>
                                </div>
                            </div>

                            <div class="form-group" id="fieldWrapRegEmail">
                                <label class="form-label" for="regEmail">Địa chỉ Email xác minh &amp; nhận vé QR *</label>
                                <div class="spk-auth-input-wrap">
                                    <span class="spk-auth-input-icon"><iconify-icon icon="lucide:at-sign" width="16"></iconify-icon></span>
                                    <input type="email" id="regEmail" name="Email" class="form-input" placeholder="athlete@spike.vn" autocomplete="email" oninput="clearFieldError('regEmail')">
                                </div>
                                <span class="field-error-msg" id="regEmailError">Email chưa đúng định dạng.</span>
                            </div>

                            <div class="form-row">
                                <div class="form-group" id="fieldWrapRegPassword">
                                    <label class="form-label" for="regPassword">Mật khẩu *</label>
                                    <div class="spk-auth-input-wrap">
                                        <span class="spk-auth-input-icon"><iconify-icon icon="lucide:key-round" width="16"></iconify-icon></span>
                                        <input type="password"
                                               id="regPassword"
                                               name="Password"
                                               class="form-input"
                                               placeholder="Tối thiểu 6 ký tự"
                                               autocomplete="new-password"
                                               oninput="clearFieldError('regPassword'); updatePasswordStrength(this.value)">
                                        <button type="button" class="spk-pass-toggle" onclick="toggleAnimatedPassword('regPassword', 'eyeIconReg')" title="Hiện / Ẩn mật khẩu">
                                            <iconify-icon id="eyeIconReg" icon="lucide:eye" width="16"></iconify-icon>
                                        </button>
                                    </div>
                                    <span class="field-error-msg" id="regPasswordError">Tối thiểu 6 ký tự.</span>
                                </div>

                                <div class="form-group" id="fieldWrapRegConfirmPassword">
                                    <label class="form-label" for="regConfirmPassword">Xác nhận MK *</label>
                                    <div class="spk-auth-input-wrap">
                                        <span class="spk-auth-input-icon"><iconify-icon icon="lucide:check-circle-2" width="16"></iconify-icon></span>
                                        <input type="password"
                                               id="regConfirmPassword"
                                               name="ConfirmPassword"
                                               class="form-input"
                                               placeholder="Nhập lại mật khẩu"
                                               autocomplete="new-password"
                                               oninput="clearFieldError('regConfirmPassword')">
                                    </div>
                                    <span class="field-error-msg" id="regConfirmPasswordError">Mật khẩu chưa khớp.</span>
                                </div>
                            </div>

                            <div class="pass-strength-wrap" style="margin-bottom:12px;">
                                <div class="pass-strength-bars">
                                    <div class="pass-strength-seg" id="passSeg1"></div>
                                    <div class="pass-strength-seg" id="passSeg2"></div>
                                    <div class="pass-strength-seg" id="passSeg3"></div>
                                    <div class="pass-strength-seg" id="passSeg4"></div>
                                </div>
                                <div id="passStrengthLabel" class="pass-strength-text">Độ mạnh mật khẩu: Chưa nhập</div>
                            </div>

                            <label style="display:flex;align-items:center;gap:8px;font-size:0.8rem;color:var(--text-secondary);margin-bottom:16px;cursor:pointer;">
                                <input type="checkbox" id="regAgreeTerms" checked style="accent-color:var(--brand-primary);">
                                <span>Tôi đồng ý với <strong style="color:var(--brand-primary-ink);">Nội quy Sân đấu</strong> &amp; Chính sách CLB</span>
                            </label>

                            <button type="submit" id="btnSubmitRegister" class="btn btn-primary btn-lg btn-block">
                                <iconify-icon icon="lucide:send" width="17"></iconify-icon>
                                <span id="btnSubmitRegisterText">Gửi mã xác minh</span>
                            </button>
                        </form>
                    </div>

                    <!-- STEP 2B: 6-DIGIT EMAIL OTP VERIFICATION -->
                    <div id="regStepVerifyOtp" class="spk-otp-stage" style="@(pendingRegState.HasPending && !serverRegisterVerified ? "display:block;" : "display:none;")">
                        <div class="spk-otp-header">
                            <div class="spk-otp-badge">
                                <iconify-icon icon="lucide:mail-check" width="16"></iconify-icon>
                                <span>Xác minh hộp thư điện tử</span>
                            </div>
                            <h2 style="font-size:1.4rem;font-weight:800;margin:6px 0 4px;">Nhập mã xác minh 6 chữ số</h2>
                            <p class="text-sm text-muted" style="line-height:1.55;">
                                Mã đã được gửi tới <strong id="otpMaskedEmailDisplay" class="spk-otp-email-pill">@(pendingRegState.MaskedEmail ?? "---")</strong>.
                                Mã có hiệu lực trong <span id="otpExpiryCountdown" class="spk-otp-mono">10:00</span>.
                            </p>
                        </div>

                        <form id="verifyOtpForm" action="/Account/VerifyRegisterOtp" method="post" onsubmit="handleVerifyOtpSubmit(event)" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="otpVerificationToken" name="verificationToken" value="@(pendingRegState.VerificationToken ?? "")" />

                            <div class="form-group" id="fieldWrapRegOtpInput" style="margin-bottom:14px;">
                                <label class="form-label" for="regOtpInput">Mã xác minh OTP (6 chữ số) *</label>
                                <input type="text"
                                       id="regOtpInput"
                                       name="otp"
                                       class="form-input spk-otp-code-input"
                                       inputmode="numeric"
                                       pattern="[0-9]*"
                                       maxlength="6"
                                       autocomplete="one-time-code"
                                       placeholder="000000"
                                       aria-describedby="otpAssistHint regOtpInputError"
                                       oninput="handleOtpDigitInput(this)"
                                       onpaste="handleOtpPaste(event)">
                                <div id="otpAssistHint" class="spk-otp-meta-row">
                                    <span>Hỗ trợ dán trực tiếp mã 6 số từ email</span>
                                    <span id="otpRemainingAttemptsText" class="spk-otp-mono">Tối đa @(pendingRegState.MaxAttempts > 0 ? pendingRegState.MaxAttempts : 5) lần thử</span>
                                </div>
                                <span class="field-error-msg" id="regOtpInputError">Vui lòng nhập đủ 6 chữ số xác minh.</span>
                            </div>

                            <button type="submit" id="btnVerifyOtpSubmit" class="btn btn-primary btn-lg btn-block">
                                <iconify-icon icon="lucide:shield-check" width="18"></iconify-icon>
                                <span id="btnVerifyOtpSubmitText">Xác nhận mã &amp; Tạo tài khoản</span>
                            </button>
                        </form>

                        <div class="spk-otp-actions">
                            <button type="button" id="btnResendOtp" class="btn btn-secondary btn-sm" onclick="handleResendOtpClick()">
                                <iconify-icon icon="lucide:refresh-cw" width="15"></iconify-icon>
                                <span id="btnResendOtpText">Gửi lại mã</span>
                            </button>
                            <button type="button" id="btnChangeRegEmail" class="spk-otp-link-btn" onclick="handleChangeRegisterEmail()">
                                <iconify-icon icon="lucide:arrow-left" width="15"></iconify-icon>
                                <span>Đổi email khác</span>
                            </button>
                        </div>
                    </div>

                    <!-- STEP 2C: REGISTRATION COMPLETED -->
                    <div id="regStepSuccess" class="spk-otp-success-card" style="@(serverRegisterVerified ? "display:block;" : "display:none;")">
                        <div class="spk-otp-success-icon">
                            <iconify-icon icon="lucide:check-circle-2" width="32"></iconify-icon>
                        </div>
                        <h2 style="font-size:1.45rem;font-weight:800;margin:0 0 8px;color:var(--text-primary);">Đăng ký thành công</h2>
                        <p id="regSuccessDesc" class="text-sm text-muted" style="margin:0 0 20px;line-height:1.6;">
                            @(serverRegisterSuccessMsg ?? "Email của bạn đã được xác minh và tài khoản hội viên đã sẵn sàng. Vui lòng đăng nhập để bắt đầu đặt sân.")
                        </p>
                        <button type="button" id="btnGoToLoginAfterVerify" class="btn btn-primary btn-lg btn-block" onclick="switchToLoginAfterRegisterSuccess()">
                            <iconify-icon icon="lucide:log-in" width="18"></iconify-icon>
                            <span>Đăng nhập</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- P1-02: Honest Forgot Password Modal -->
<div class="modal-backdrop" id="forgotPasswordModal">
    <div class="modal" style="max-width: 440px;">
        <div class="modal-header">
            <h3 class="modal-title">Hỗ trợ khôi phục mật khẩu</h3>
            <button type="button" class="modal-close" onclick="closeModal('forgotPasswordModal')">✕</button>
        </div>
        <div class="modal-body flex-col gap-3">
            <div class="sn-alert sn-alert-warning" style="margin-bottom:0;font-weight:500;line-height:1.5;">
                <div>
                    <strong>Thông báo minh bạch:</strong> Hệ thống hiện chưa kích hoạt cổng gửi SMS/Email OTP tự động. CLB không tự động đặt lại mật khẩu qua biểu mẫu công khai.
                </div>
            </div>
            <p class="text-xs text-muted" style="line-height:1.6;">
                Vui lòng liên hệ trực tiếp <strong>Quầy lễ tân CLB</strong> hoặc gọi <strong>Hotline <span data-cms="hotline">0901 234 567</span></strong> để xác minh thông tin chính chủ và nhận mật khẩu tạm thời dùng 1 lần.
            </p>
            <div id="forgotStatusBox" class="sn-alert sn-alert-danger" style="display:none;margin-bottom:0;font-size:0.8rem;"></div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeModal('forgotPasswordModal')">Đã hiểu &amp; Đóng</button>
            <button type="button" class="btn btn-primary" onclick="handleResetPassword()">Kiểm tra cổng OTP</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.__INITIAL_REG_OTP_STATE__ = @Html.Raw(initialOtpStateJson);
    </script>
    <script src="~/js/pages/auth.js" asp-append-version="true"></script>
}
