@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập & Đăng ký — Spike Pickleball Club</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
  <style>
    /* ==========================================================================
       ANIMATED INTERACTIVE AUTHENTICATION STAGE (STANDALONE)
       Inspired by Rive Interactive Mascot + Sliding Overlay Dual-Panel Auth
       ========================================================================== */
    :root {
      --auth-bg-deep: #060B16;
      --auth-bg-card: rgba(15, 23, 42, 0.82);
      --auth-neon-orange: #FF5520;
      --auth-neon-volt: #D4FF00;
      --auth-neon-emerald: #10B981;
      --auth-neon-cyan: #38BDF8;
      --auth-border: rgba(255, 255, 255, 0.11);
      --auth-text: #F8FAFC;
      --auth-muted: #94A3B8;
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-slide: cubic-bezier(0.65, 0, 0.35, 1);
    }

    * {
      box-sizing: border-box;
    }

    body.animated-auth-body {
      margin: 0;
      min-height: 100vh;
      background: radial-gradient(circle at 15% 15%, rgba(255, 85, 32, 0.16), transparent 42%),
                  radial-gradient(circle at 85% 80%, rgba(212, 255, 0, 0.12), transparent 45%),
                  radial-gradient(circle at 50% 50%, #0B1325 0%, #050912 100%);
      color: var(--auth-text);
      font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      overflow-x: hidden;
      position: relative;
    }

    /* Interactive Background Canvas */
    #loginArenaCanvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* Ambient Floating Glow Orbs */
    .ambient-orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(85px);
      z-index: 0;
      pointer-events: none;
      animation: orbFloat 14s ease-in-out infinite alternate;
    }
    .ambient-orb.orb-1 {
      width: 380px;
      height: 380px;
      background: rgba(255, 85, 32, 0.18);
      top: -80px;
      left: -80px;
    }
    .ambient-orb.orb-2 {
      width: 340px;
      height: 340px;
      background: rgba(212, 255, 0, 0.12);
      bottom: -70px;
      right: -60px;
      animation-delay: -5s;
    }
    @@keyframes orbFloat {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(45px, 30px) scale(1.12); }
    }

    /* Top Floating Navigation Bar */
    .auth-floating-topbar {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 1060px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
      padding: 0 0.25rem;
    }

    .auth-top-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      text-decoration: none;
      color: #FFF;
      group: true;
    }

    .auth-top-logo {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--auth-neon-orange), #E03E00);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFF;
      box-shadow: 0 8px 20px rgba(255, 85, 32, 0.35);
      transition: transform 0.3s var(--ease-spring);
    }

    .auth-top-brand:hover .auth-top-logo {
      transform: rotate(-12deg) scale(1.08);
    }

    .auth-top-title {
      font-family: var(--font-display, 'Oswald', sans-serif);
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1.1;
      display: block;
    }

    .auth-top-sub {
      font-size: 0.68rem;
      color: var(--auth-neon-volt);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .auth-back-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.14);
      color: #E2E8F0;
      font-size: 0.8rem;
      font-weight: 600;
      text-decoration: none;
      backdrop-filter: blur(10px);
      transition: all 0.25s ease;
    }

    .auth-back-pill:hover {
      background: rgba(255, 255, 255, 0.14);
      color: #FFF;
      transform: translateX(-3px);
    }

    /* ==========================================================================
       MAIN DOUBLE-SLIDER STAGE CONTAINER
       ========================================================================== */
    .auth-stage-box {
      position: relative;
      z-index: 5;
      width: 100%;
      max-width: 1060px;
      min-height: 670px;
      background: var(--auth-bg-card);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-radius: 28px;
      border: 1px solid var(--auth-border);
      box-shadow: 0 30px 80px -15px rgba(0, 0, 0, 0.7),
                  0 0 0 1px rgba(255, 255, 255, 0.05) inset;
      overflow: hidden;
      transition: transform 0.3s ease;
    }

    .auth-stage-box.shake-error {
      animation: stageShake 0.48s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    @@keyframes stageShake {
      10%, 90% { transform: translate3d(-4px, 0, 0); }
      20%, 80% { transform: translate3d(6px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-8px, 0, 0); }
      40%, 60% { transform: translate3d(8px, 0, 0); }
    }

    /* Form Panels (Sign In Left, Sign Up Right) */
    .form-panel {
      position: absolute;
      top: 0;
      height: 100%;
      width: 50%;
      padding: 1.75rem 2.6rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transition: all 0.68s var(--ease-slide);
    }

    .sign-in-panel {
      left: 0;
      z-index: 2;
      opacity: 1;
    }

    .sign-up-panel {
      left: 0;
      width: 50%;
      opacity: 0;
      z-index: 1;
      pointer-events: none;
    }

    /* Active State when switched to Sign Up */
    .auth-stage-box.right-panel-active .sign-in-panel {
      transform: translateX(100%);
      opacity: 0;
      pointer-events: none;
    }

    .auth-stage-box.right-panel-active .sign-up-panel {
      transform: translateX(100%);
      opacity: 1;
      z-index: 5;
      pointer-events: auto;
    }

    /* ==========================================================================
       INTERACTIVE ANIMATED MASCOT (PICKLEBALL PRO BOT)
       ========================================================================== */
    .mascot-stage {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 0.9rem;
      padding: 0.65rem 0.95rem;
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
      border: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .mascot-avatar-box {
      width: 82px;
      height: 82px;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 35%, #1E293B, #090D16);
      border: 2px solid rgba(212, 255, 0, 0.35);
      box-shadow: 0 0 25px rgba(212, 255, 0, 0.12), inset 0 0 15px rgba(0, 0, 0, 0.6);
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mascot-svg {
      width: 78px;
      height: 78px;
      overflow: visible;
    }

    /* Smooth SVG transforms for mascot parts */
    #mascotHeadGroup {
      transition: transform 0.12s ease-out;
      transform-origin: 50px 52px;
    }

    #mascotEyesGroup {
      transition: transform 0.08s ease-out;
      transform-origin: 50px 46px;
    }

    .mascot-eye-lid {
      transform-origin: center;
      animation: mascotBlink 4.5s infinite;
    }

    @@keyframes mascotBlink {
      0%, 94%, 98%, 100% { transform: scaleY(1); }
      96% { transform: scaleY(0.08); }
    }

    /* Carbon Pickleball Paddle that covers eyes on password focus */
    #mascotPaddleShield {
      transform: translateY(58px) rotate(18deg) scale(0.85);
      transform-origin: 50px 75px;
      transition: transform 0.44s var(--ease-spring);
    }

    /* State: Covering Eyes (Password Focused) */
    .mascot-avatar-box[data-state="password"] #mascotPaddleShield {
      transform: translateY(0px) rotate(0deg) scale(1);
    }
    .mascot-avatar-box[data-state="password"] #mascotHeadGroup {
      transform: translateY(2px);
    }

    /* State: Peeking Over Paddle (Show Password Clicked) */
    .mascot-avatar-box[data-state="peek"] #mascotPaddleShield {
      transform: translateY(15px) rotate(-6deg) scale(0.96);
    }
    .mascot-avatar-box[data-state="peek"] #mascotEyesGroup {
      transform: translateY(-4px) scale(1.08);
    }

    /* State: Success Smash */
    .mascot-avatar-box[data-state="success"] {
      border-color: var(--auth-neon-emerald);
      box-shadow: 0 0 30px rgba(16, 185, 129, 0.45);
    }

    /* State: Error Alert */
    .mascot-avatar-box[data-state="error"] {
      border-color: #EF4444;
      box-shadow: 0 0 30px rgba(239, 68, 68, 0.45);
    }

    .mascot-dialogue {
      flex: 1;
      min-width: 0;
    }

    .mascot-status-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.66rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--auth-neon-volt);
      margin-bottom: 0.15rem;
    }

    .mascot-status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--auth-neon-volt);
      box-shadow: 0 0 8px var(--auth-neon-volt);
    }

    .mascot-title {
      font-family: var(--font-display, 'Oswald', sans-serif);
      font-size: 1.25rem;
      font-weight: 700;
      color: #FFF;
      margin: 0 0 0.15rem;
      letter-spacing: 0.01em;
    }

    .mascot-speech {
      font-size: 0.78rem;
      color: #CBD5E1;
      margin: 0;
      line-height: 1.35;
      transition: color 0.2s ease;
    }

    /* ==========================================================================
       FLOATING LABEL INPUTS WITH LASER UNDERLINE ANIMATION
       ========================================================================== */
    .anim-field {
      position: relative;
      margin-bottom: 0.9rem;
    }

    .anim-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 13px;
      transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
      overflow: hidden;
    }

    .anim-input-wrap:focus-within {
      border-color: rgba(255, 85, 32, 0.65);
      background: rgba(15, 23, 42, 0.95);
      box-shadow: 0 0 0 3px rgba(255, 85, 32, 0.15);
    }

    .anim-field.has-error .anim-input-wrap {
      border-color: #EF4444;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
    }

    /* Animated Laser Sweep Bar at bottom of input */
    .anim-input-laser {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--auth-neon-orange), var(--auth-neon-volt));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s var(--ease-slide);
    }

    .anim-input-wrap:focus-within .anim-input-laser {
      transform: scaleX(1);
    }

    .anim-input-icon {
      padding-left: 0.95rem;
      color: #64748B;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.25s ease, transform 0.25s var(--ease-spring);
    }

    .anim-input-wrap:focus-within .anim-input-icon {
      color: var(--auth-neon-orange);
      transform: scale(1.12);
    }

    .anim-input {
      width: 100%;
      background: transparent;
      border: none;
      outline: none;
      color: #FFF;
      font-size: 0.88rem;
      font-family: inherit;
      padding: 1.25rem 0.9rem 0.45rem 0.65rem;
    }

    .anim-input::placeholder {
      color: transparent;
    }

    .anim-label {
      position: absolute;
      left: 2.65rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.84rem;
      color: #94A3B8;
      pointer-events: none;
      transition: all 0.22s ease;
      transform-origin: left top;
    }

    /* Float label up when input is focused or not empty */
    .anim-input:focus ~ .anim-label,
    .anim-input:not(:placeholder-shown) ~ .anim-label {
      top: 0.38rem;
      transform: translateY(0) scale(0.76);
      color: var(--auth-neon-volt);
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .anim-pass-toggle {
      background: none;
      border: none;
      color: #64748B;
      padding: 0 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      transition: color 0.2s ease, transform 0.2s ease;
    }

    .anim-pass-toggle:hover {
      color: var(--auth-neon-volt);
      transform: scale(1.1);
    }

    .anim-error-msg {
      display: none;
      font-size: 0.72rem;
      color: #F87171;
      margin-top: 0.25rem;
      padding-left: 0.25rem;
      font-weight: 500;
    }

    .anim-field.has-error .anim-error-msg {
      display: block;
      animation: fadeSlideDown 0.2s ease;
    }

    @@keyframes fadeSlideDown {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       1-CLICK DEMO ROLE PILLS & SOCIAL CHIPS
       ========================================================================== */
    .demo-quick-strip {
      margin-bottom: 0.95rem;
    }

    .demo-strip-label {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: #94A3B8;
      margin-bottom: 0.45rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .demo-pills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
    }

    .demo-pill-btn {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.55rem 0.75rem;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #E2E8F0;
      cursor: pointer;
      text-align: left;
      transition: all 0.25s ease;
      overflow: hidden;
    }

    .demo-pill-btn:hover {
      background: rgba(255, 255, 255, 0.09);
      transform: translateY(-2px);
    }

    .demo-pill-btn.active {
      background: rgba(255, 85, 32, 0.14);
      border-color: var(--auth-neon-orange);
      box-shadow: 0 6px 18px rgba(255, 85, 32, 0.2);
    }

    .demo-pill-info {
      display: flex;
      flex-direction: column;
      gap: 0.08rem;
    }

    .demo-pill-role {
      font-size: 0.78rem;
      font-weight: 700;
      color: #FFF;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .demo-pill-email {
      font-size: 0.67rem;
      color: #94A3B8;
      font-family: var(--font-mono, monospace);
    }

    .demo-pill-go {
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--auth-neon-volt);
      padding: 0.2rem 0.45rem;
      border-radius: 6px;
      background: rgba(212, 255, 0, 0.12);
      transition: all 0.2s ease;
    }

    .demo-pill-btn:hover .demo-pill-go {
      background: var(--auth-neon-volt);
      color: #090D16;
    }

    /* Animated Primary Submit Button */
    .btn-anim-submit {
      position: relative;
      width: 100%;
      height: 48px;
      border: none;
      border-radius: 13px;
      background: linear-gradient(135deg, #FF5520 0%, #E03E00 100%);
      color: #FFF;
      font-family: var(--font-display, 'Oswald', sans-serif);
      font-size: 0.98rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      box-shadow: 0 10px 25px -5px rgba(255, 85, 32, 0.5);
      transition: all 0.3s var(--ease-spring);
      overflow: hidden;
    }

    .btn-anim-submit::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
      transform: skewX(-20deg);
      transition: left 0.6s ease;
    }

    .btn-anim-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px -5px rgba(255, 85, 32, 0.65);
    }

    .btn-anim-submit:hover::before {
      left: 140%;
    }

    .btn-anim-submit.loading {
      pointer-events: none;
      background: linear-gradient(135deg, #10B981, #059669);
    }

    /* Social Login Buttons */
    .social-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.55rem;
      margin-top: 0.85rem;
    }

    .social-chip {
      height: 38px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #E2E8F0;
      font-size: 0.76rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .social-chip:hover {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.24);
      transform: translateY(-2px);
    }

    /* ==========================================================================
       SLIDING OVERLAY CURTAIN (THE SIGNATURE DOUBLE-SLIDER ANIMATION)
       ========================================================================== */
    .overlay-container {
      position: absolute;
      top: 0;
      left: 50%;
      width: 50%;
      height: 100%;
      overflow: hidden;
      transition: transform 0.68s var(--ease-slide);
      z-index: 50;
    }

    .auth-stage-box.right-panel-active .overlay-container {
      transform: translateX(-100%);
    }

    .overlay-curtain {
      position: relative;
      left: -100%;
      height: 100%;
      width: 200%;
      background:
        linear-gradient(155deg, rgba(6, 11, 22, 0.82) 0%, rgba(15, 23, 42, 0.72) 50%, rgba(255, 85, 32, 0.32) 100%),
        url('/assets/hero-spike-pickleball.png') center/cover no-repeat;
      transform: translateX(0);
      transition: transform 0.68s var(--ease-slide);
    }

    /* Animated Court Lines Overlay Pattern */
    .overlay-curtain::before {
      content: '';
      position: absolute;
      inset: 22px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 18px;
      pointer-events: none;
    }

    .auth-stage-box.right-panel-active .overlay-curtain {
      transform: translateX(50%);
    }

    .overlay-panel {
      position: absolute;
      top: 0;
      height: 100%;
      width: 50%;
      padding: 2.5rem 2.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.68s var(--ease-slide);
    }

    .overlay-left {
      transform: translateX(-20%);
    }

    .auth-stage-box.right-panel-active .overlay-left {
      transform: translateX(0);
    }

    .overlay-right {
      right: 0;
      transform: translateX(0);
    }

    .auth-stage-box.right-panel-active .overlay-right {
      transform: translateX(20%);
    }

    /* Floating 3D Pickleball Widget inside Overlay */
    .floating-ball-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      background: rgba(9, 13, 22, 0.72);
      border: 1px solid rgba(212, 255, 0, 0.35);
      backdrop-filter: blur(12px);
      width: fit-content;
    }

    .spinning-pickleball {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #E5FF44, #99CC00);
      box-shadow: 0 0 12px rgba(212, 255, 0, 0.6);
      position: relative;
      animation: spinBall 6s linear infinite;
    }

    .spinning-pickleball::after {
      content: '';
      position: absolute;
      inset: 4px;
      border: 2px dotted rgba(9, 13, 22, 0.65);
      border-radius: 50%;
    }

    @@keyframes spinBall {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .overlay-headline {
      font-family: var(--font-display, 'Oswald', sans-serif);
      font-size: 2.25rem;
      font-weight: 800;
      text-transform: uppercase;
      line-height: 1.08;
      color: #FFF;
      margin: 0 0 0.85rem;
      letter-spacing: 0.01em;
    }

    .overlay-headline em {
      font-style: normal;
      color: var(--auth-neon-volt);
    }

    .overlay-desc {
      font-size: 0.9rem;
      color: #E2E8F0;
      line-height: 1.6;
      margin: 0 0 1.4rem;
    }

    .overlay-switch-card {
      background: rgba(9, 13, 22, 0.76);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 18px;
      padding: 1.25rem 1.4rem;
    }

    .btn-overlay-switch {
      margin-top: 0.75rem;
      width: 100%;
      height: 44px;
      border-radius: 999px;
      background: var(--auth-neon-volt);
      color: #090D16;
      border: none;
      font-family: var(--font-display, 'Oswald', sans-serif);
      font-size: 0.92rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 8px 25px rgba(212, 255, 0, 0.3);
      transition: all 0.25s var(--ease-spring);
    }

    .btn-overlay-switch:hover {
      transform: scale(1.03);
      background: #E2FF33;
      box-shadow: 0 12px 30px rgba(212, 255, 0, 0.45);
    }

    /* Password Strength Meter in Sign Up */
    .strength-meter {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin: -0.25rem 0 0.6rem;
    }

    .strength-bar {
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      transition: background 0.3s ease;
    }

    /* Alert banners inside form */
    .anim-alert {
      display: none;
      align-items: center;
      gap: 0.55rem;
      padding: 0.6rem 0.85rem;
      border-radius: 11px;
      font-size: 0.78rem;
      font-weight: 600;
      margin-bottom: 0.8rem;
      animation: fadeSlideDown 0.25s ease;
    }

    .anim-alert.danger {
      background: rgba(239, 68, 68, 0.16);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #FCA5A5;
    }

    .anim-alert.warning {
      background: rgba(245, 158, 11, 0.16);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #FDE68A;
    }

    .anim-alert.session {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #A7F3D0;
      justify-content: space-between;
    }

    /* Mobile Mode Switcher (visible < 900px) */
    .mobile-mode-switcher {
      display: none;
      width: 100%;
      max-width: 480px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid var(--auth-border);
      border-radius: 999px;
      padding: 0.3rem;
      margin-bottom: 1rem;
      z-index: 10;
    }

    .mobile-mode-btn {
      flex: 1;
      height: 38px;
      border: none;
      border-radius: 999px;
      background: transparent;
      color: #94A3B8;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .mobile-mode-btn.active {
      background: var(--auth-neon-orange);
      color: #FFF;
    }

    @@media (max-width: 900px) {
      .overlay-container {
        display: none;
      }
      .mobile-mode-switcher {
        display: flex;
      }
      .auth-stage-box {
        max-width: 500px;
        min-height: 640px;
      }
      .form-panel {
        width: 100%;
        padding: 1.5rem;
      }
      .auth-stage-box.right-panel-active .sign-in-panel {
        transform: translateX(-100%);
      }
      .auth-stage-box.right-panel-active .sign-up-panel {
        transform: translateX(0);
        width: 100%;
      }
    }
  </style>
</head>
<body class="animated-auth-body">

  <!-- CANVAS HẠT NĂNG LƯỢNG & QUỸ ĐẠO BÓNG TƯƠNG TÁC -->
  <canvas id="loginArenaCanvas"></canvas>
  <div class="ambient-orb orb-1"></div>
  <div class="ambient-orb orb-2"></div>

  <!-- THANH ĐIỀU HƯỚNG NỔI TRÊN CÙNG -->
  <header class="auth-floating-topbar">
    <a href="/" class="auth-top-brand">
      <div class="auth-top-logo">
        <iconify-icon icon="lucide:zap" width="22"></iconify-icon>
      </div>
      <div>
        <span class="auth-top-title">Spike Pickleball</span>
        <span class="auth-top-sub">Interactive Arena ID</span>
      </div>
    </a>

    <a href="/" class="auth-back-pill">
      <iconify-icon icon="lucide:arrow-left" width="16"></iconify-icon>
      <span>Quay về Trang chủ CLB</span>
    </a>
  </header>

  <!-- NÚT CHUYỂN CHẾ ĐỘ TRÊN MOBILE -->
  <div class="mobile-mode-switcher">
    <button type="button" class="mobile-mode-btn active" id="mobTabLogin" onclick="switchAuthMode('login')">Đăng nhập</button>
    <button type="button" class="mobile-mode-btn" id="mobTabRegister" onclick="switchAuthMode('register')">Đăng ký Hội viên</button>
  </div>

  <!-- ==========================================================================
       KHUNG SÂN KHẤU ĐĂNG NHẬP / ĐĂNG KÝ CHUYỂN ĐỘNG TRƯỢT 2 CHIỀU
       ========================================================================== -->
  <div class="auth-stage-box" id="authStageBox">

    <!-- ==================== PANEL 1: ĐĂNG NHẬP (BÊN TRÁI) ==================== -->
    <div class="form-panel sign-in-panel">

      <!-- MASCOT TƯƠNG TÁC THEO DÕI ÁNH MẮT & CHE MẶT KHI NHẬP MẬT KHẨU -->
      <div class="mascot-stage">
        <div class="mascot-avatar-box" id="mascotBox" data-state="idle">
          <svg class="mascot-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Vòng hào quang sân đấu -->
            <circle cx="50" cy="54" r="36" fill="url(#botGlow)" opacity="0.25"/>
            <!-- Thân VĐV Robot -->
            <path d="M24 88C24 73 35 66 50 66C65 66 76 73 76 88" fill="#1E293B" stroke="#38BDF8" stroke-width="2"/>
            <path d="M38 68L50 80L62 68" stroke="#FF5520" stroke-width="3" stroke-linecap="round"/>

            <!-- Nhóm Đầu & Băng đô Thể thao (Di chuyển theo con trỏ & chữ đang gõ) -->
            <g id="mascotHeadGroup">
              <!-- Tai nghe thể thao 2 bên -->
              <rect x="14" y="36" width="8" height="18" rx="4" fill="#FF5520"/>
              <rect x="78" y="36" width="8" height="18" rx="4" fill="#FF5520"/>
              <!-- Đầu -->
              <rect x="20" y="20" width="60" height="46" rx="22" fill="#F8FAFC" stroke="#0F172A" stroke-width="2.5"/>
              <!-- Băng đô Pickleball Pro -->
              <path d="M21 31C35 26 65 26 79 31L80 25C65 20 35 20 20 25Z" fill="#FF5520"/>
              <circle cx="50" cy="26" r="3.5" fill="#D4FF00"/>

              <!-- Kính Visor Điện Tử -->
              <rect x="26" y="34" width="48" height="22" rx="11" fill="#090D16" stroke="#334155" stroke-width="1.5"/>

              <!-- Đôi Mắt LED Biểu Cảm (Di chuyển theo từng ký tự Email/Mật khẩu) -->
              <g id="mascotEyesGroup">
                <g class="mascot-eye-lid">
                  <circle id="eyeLeft" cx="39" cy="45" r="5.2" fill="#D4FF00"/>
                  <circle cx="40.8" cy="43.2" r="1.8" fill="#FFFFFF"/>
                </g>
                <g class="mascot-eye-lid">
                  <circle id="eyeRight" cx="61" cy="45" r="5.2" fill="#D4FF00"/>
                  <circle cx="62.8" cy="43.2" r="1.8" fill="#FFFFFF"/>
                </g>
              </g>

              <!-- Miệng biểu cảm -->
              <path id="mascotMouth" d="M44 60Q50 64 56 60" stroke="#0F172A" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            </g>

            <!-- VỢT CARBON PICKLEBALL (Đưa lên che mắt khi nhập mật khẩu!) -->
            <g id="mascotPaddleShield">
              <!-- Mặt vợt Carbon -->
              <rect x="25" y="18" width="50" height="44" rx="14" fill="#0F172A" stroke="#D4FF00" stroke-width="2.5"/>
              <!-- Lưới sợi Carbon trên mặt vợt -->
              <line x1="33" y1="26" x2="67" y2="26" stroke="#1E293B" stroke-width="1.5"/>
              <line x1="33" y1="34" x2="67" y2="34" stroke="#1E293B" stroke-width="1.5"/>
              <line x1="33" y1="42" x2="67" y2="42" stroke="#1E293B" stroke-width="1.5"/>
              <circle cx="50" cy="38" r="7" fill="#FF5520" opacity="0.9"/>
              <text x="50" y="41" text-anchor="middle" fill="#FFF" font-size="7" font-weight="800" font-family="sans-serif">PRO</text>
              <!-- Hai bàn tay cầm vợt che mắt -->
              <circle cx="26" cy="44" r="6" fill="#F8FAFC" stroke="#0F172A" stroke-width="2"/>
              <circle cx="74" cy="44" r="6" fill="#F8FAFC" stroke="#0F172A" stroke-width="2"/>
              <!-- Cán vợt -->
              <rect x="46" y="62" width="8" height="18" rx="3" fill="#FF5520"/>
            </g>

            <defs>
              <radialGradient id="botGlow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(50 54) scale(36)">
                <stop stop-color="#D4FF00"/>
                <stop offset="1" stop-color="#D4FF00" stop-opacity="0"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <div class="mascot-dialogue">
          <div class="mascot-status-tag">
            <span class="mascot-status-dot" id="mascotDot"></span>
            <span id="mascotStateLabel">ACE BOT · TRỢ LÝ SÂN ĐẤU</span>
          </div>
          <h2 class="mascot-title" id="authCardTitle">Chào mừng ra sân!</h2>
          <p class="mascot-speech" id="mascotSpeechText">Nhập Email/Số điện thoại đã đăng ký để vào sân, hoặc trượt sang phải để tạo tài khoản mới!</p>
        </div>
      </div>

      <!-- Banner nếu đang có phiên đăng nhập -->
      <div id="activeSessionBanner" class="anim-alert session">
        <span>Đang đăng nhập: <strong id="activeSessionName">---</strong> (<span id="activeSessionRole">---</span>)</span>
        <div style="display:flex;gap:0.4rem;">
          <a href="/" class="demo-pill-go" style="text-decoration:none;">Trang chủ</a>
          <button type="button" onclick="logout()" style="background:none;border:none;color:#FCA5A5;font-size:0.72rem;font-weight:700;cursor:pointer;">Thoát</button>
        </div>
      </div>

      <!-- Cảnh báo quyền truy cập -->
      <div id="redirectAlert" class="anim-alert warning">
        <iconify-icon icon="lucide:shield-alert" width="17"></iconify-icon>
        <span id="redirectAlertText">Vui lòng đăng nhập để tiếp tục.</span>
      </div>

      <!-- Báo lỗi xác thực -->
      <div id="loginErrorAlert" class="anim-alert danger">
        <iconify-icon icon="lucide:alert-triangle" width="17"></iconify-icon>
        <span id="loginErrorText">Thông tin đăng nhập chưa chính xác.</span>
      </div>

      <!-- FORM ĐĂNG NHẬP -->
      <form id="loginForm" onsubmit="handleFormLogin(event)" novalidate>
        <div class="anim-field" id="fieldWrapLoginEmail">
          <div class="anim-input-wrap">
            <span class="anim-input-icon"><iconify-icon icon="lucide:mail" width="18"></iconify-icon></span>
            <input
              type="text"
              id="loginEmail"
              class="anim-input"
              placeholder="Email hoặc Số điện thoại"
              autocomplete="username"
              onfocus="onEmailFocus()"
              onblur="onInputBlur()"
              oninput="onEmailInput(this.value); clearFieldError('loginEmail')"
            >
            <label class="anim-label" for="loginEmail">Email hoặc Số điện thoại *</label>
            <span class="anim-input-laser"></span>
          </div>
          <span class="anim-error-msg" id="loginEmailError">Vui lòng nhập Email hoặc SĐT hợp lệ (9–11 số).</span>
        </div>

        <div class="anim-field" id="fieldWrapLoginPassword">
          <div class="anim-input-wrap">
            <span class="anim-input-icon"><iconify-icon icon="lucide:lock" width="18"></iconify-icon></span>
            <input
              type="password"
              id="loginPassword"
              class="anim-input"
              placeholder="Mật khẩu"
              autocomplete="current-password"
              onfocus="onPasswordFocus()"
              onblur="onInputBlur()"
              oninput="clearFieldError('loginPassword')"
            >
            <label class="anim-label" for="loginPassword">Mật khẩu bảo mật *</label>
            <button type="button" class="anim-pass-toggle" onclick="toggleAnimatedPassword('loginPassword', 'eyeIconLogin')" title="Hiện / Ẩn mật khẩu">
              <iconify-icon id="eyeIconLogin" icon="lucide:eye" width="18"></iconify-icon>
            </button>
            <span class="anim-input-laser"></span>
          </div>
          <span class="anim-error-msg" id="loginPasswordError">Mật khẩu cần tối thiểu 6 ký tự.</span>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin:0.2rem 0 0.95rem;font-size:0.78rem;">
          <label style="display:inline-flex;align-items:center;gap:0.45rem;color:#CBD5E1;cursor:pointer;">
            <input type="checkbox" id="rememberMe" checked style="accent-color:var(--auth-neon-orange);">
            <span>Lưu phiên đăng nhập 30 ngày</span>
          </label>
          <a href="javascript:void(0)" onclick="openModal('forgotPasswordModal')" style="color:var(--auth-neon-volt);text-decoration:none;font-weight:700;">Quên mật khẩu?</a>
        </div>

        <button type="submit" id="btnSubmitLogin" class="btn-anim-submit">
          <iconify-icon icon="lucide:log-in" width="19"></iconify-icon>
          <span id="btnSubmitLoginText">Đăng nhập vào Sân Đấu</span>
        </button>

        <div class="social-row">
          <button type="button" class="social-chip" onclick="handleSocialLogin('Google')">
            <iconify-icon icon="logos:google-icon" width="15"></iconify-icon>
            <span>Google</span>
          </button>
          <button type="button" class="social-chip" onclick="handleSocialLogin('Zalo')">
            <iconify-icon icon="lucide:message-circle" width="15" style="color:#38BDF8;"></iconify-icon>
            <span>Zalo ID</span>
          </button>
          <button type="button" class="social-chip" onclick="handleSocialLogin('Apple')">
            <iconify-icon icon="lucide:apple" width="15"></iconify-icon>
            <span>Apple</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ==================== PANEL 2: ĐĂNG KÝ HỘI VIÊN (BÊN PHẢI) ==================== -->
    <div class="form-panel sign-up-panel">
      <div style="margin-bottom:1rem;">
        <div class="mascot-status-tag">
          <span class="mascot-status-dot"></span>
          <span>THẺ THÀNH VIÊN ĐIỆN TỬ USAPA</span>
        </div>
        <h2 class="mascot-title" style="font-size:1.5rem;">Tạo Tài Khoản Hội Viên</h2>
        <p class="mascot-speech">Nhận ngay mã QR định danh, giảm 15% giá sân giờ vàng và tích điểm DUPR.</p>
      </div>

      <!-- Báo lỗi xác thực bên form Đăng ký -->
      <div id="registerErrorAlert" class="anim-alert danger">
        <iconify-icon icon="lucide:alert-triangle" width="17"></iconify-icon>
        <span id="registerErrorText">Vui lòng kiểm tra lại thông tin đăng ký.</span>
      </div>

      <form id="registerForm" onsubmit="handleFormRegister(event)" novalidate>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;">
          <div class="anim-field" id="fieldWrapRegFullName">
            <div class="anim-input-wrap">
              <span class="anim-input-icon"><iconify-icon icon="lucide:user" width="17"></iconify-icon></span>
              <input type="text" id="regFullName" class="anim-input" placeholder="Họ và tên" oninput="clearFieldError('regFullName')">
              <label class="anim-label" for="regFullName">Họ và tên *</label>
              <span class="anim-input-laser"></span>
            </div>
            <span class="anim-error-msg" id="regFullNameError">Nhập tối thiểu 2 ký tự.</span>
          </div>

          <div class="anim-field" id="fieldWrapRegPhone">
            <div class="anim-input-wrap">
              <span class="anim-input-icon"><iconify-icon icon="lucide:phone" width="17"></iconify-icon></span>
              <input type="tel" id="regPhone" class="anim-input" placeholder="Số điện thoại" oninput="clearFieldError('regPhone')">
              <label class="anim-label" for="regPhone">Số điện thoại *</label>
              <span class="anim-input-laser"></span>
            </div>
            <span class="anim-error-msg" id="regPhoneError">SĐT gồm 9–11 chữ số.</span>
          </div>
        </div>

        <div class="anim-field" id="fieldWrapRegEmail">
          <div class="anim-input-wrap">
            <span class="anim-input-icon"><iconify-icon icon="lucide:at-sign" width="17"></iconify-icon></span>
            <input type="email" id="regEmail" class="anim-input" placeholder="Địa chỉ Email" oninput="clearFieldError('regEmail')">
            <label class="anim-label" for="regEmail">Địa chỉ Email nhận vé QR *</label>
            <span class="anim-input-laser"></span>
          </div>
          <span class="anim-error-msg" id="regEmailError">Email chưa đúng định dạng.</span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.65rem;">
          <div class="anim-field" id="fieldWrapRegPassword">
            <div class="anim-input-wrap">
              <span class="anim-input-icon"><iconify-icon icon="lucide:key-round" width="17"></iconify-icon></span>
              <input
                type="password"
                id="regPassword"
                class="anim-input"
                placeholder="Mật khẩu"
                oninput="clearFieldError('regPassword'); updatePasswordStrength(this.value)"
              >
              <label class="anim-label" for="regPassword">Mật khẩu *</label>
              <button type="button" class="anim-pass-toggle" onclick="toggleAnimatedPassword('regPassword', 'eyeIconReg')">
                <iconify-icon id="eyeIconReg" icon="lucide:eye" width="16"></iconify-icon>
              </button>
              <span class="anim-input-laser"></span>
            </div>
            <span class="anim-error-msg" id="regPasswordError">Tối thiểu 6 ký tự.</span>
          </div>

          <div class="anim-field" id="fieldWrapRegConfirmPassword">
            <div class="anim-input-wrap">
              <span class="anim-input-icon"><iconify-icon icon="lucide:check-circle-2" width="17"></iconify-icon></span>
              <input
                type="password"
                id="regConfirmPassword"
                class="anim-input"
                placeholder="Nhập lại MK"
                oninput="clearFieldError('regConfirmPassword')"
              >
              <label class="anim-label" for="regConfirmPassword">Xác nhận MK *</label>
              <span class="anim-input-laser"></span>
            </div>
            <span class="anim-error-msg" id="regConfirmPasswordError">Mật khẩu chưa khớp.</span>
          </div>
        </div>

        <!-- Thanh đo độ mạnh mật khẩu -->
        <div class="strength-meter">
          <div class="strength-bar" id="passSeg1"></div>
          <div class="strength-bar" id="passSeg2"></div>
          <div class="strength-bar" id="passSeg3"></div>
          <div class="strength-bar" id="passSeg4"></div>
        </div>
        <div id="passStrengthLabel" style="font-size:0.71rem;color:#94A3B8;margin-bottom:0.75rem;">Độ mạnh mật khẩu: Chưa nhập</div>

        <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.76rem;color:#CBD5E1;margin-bottom:0.95rem;cursor:pointer;">
          <input type="checkbox" id="regAgreeTerms" checked style="accent-color:var(--auth-neon-orange);">
          <span>Tôi đồng ý với <strong style="color:var(--auth-neon-volt);">Quy chế Sân đấu USAPA</strong> & Chính sách CLB</span>
        </label>

        <button type="submit" class="btn-anim-submit">
          <iconify-icon icon="lucide:sparkles" width="18"></iconify-icon>
          <span>Khởi tạo Thẻ Hội Viên Ngay</span>
        </button>
      </form>
    </div>

    <!-- ==================== TẤM RÈM TRƯỢT OVERLAY 2 CHIỀU (SLIDING CURTAIN) ==================== -->
    <div class="overlay-container">
      <div class="overlay-curtain">

        <!-- OVERLAY TRÁI (Hiện khi người dùng đang ở tab ĐĂNG KÝ bên phải) -->
        <div class="overlay-panel overlay-left">
          <div class="floating-ball-badge">
            <div class="spinning-pickleball"></div>
            <span style="font-size:0.74rem;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:#FFF;">Đã có Thẻ Hội Viên?</span>
          </div>

          <div>
            <h2 class="overlay-headline">Sẵn Sàng Trở Lại <em>Sân Đấu</em> Ngay Hôm Nay!</h2>
            <p class="overlay-desc">
              Đăng nhập bằng tài khoản của bạn để kiểm tra lịch trống 4 sân trực tiếp, mở mã QR Check-in tại quầy và chia tiền sân tự động cùng đồng đội.
            </p>
          </div>

          <div class="overlay-switch-card">
            <div style="font-size:0.8rem;color:#E2E8F0;font-weight:600;">Bạn đã là thành viên của Spike Pickleball Club?</div>
            <button type="button" class="btn-overlay-switch" onclick="switchAuthMode('login')">
              <iconify-icon icon="lucide:arrow-left" width="18"></iconify-icon>
              <span>Trượt về màn hình Đăng nhập</span>
            </button>
          </div>
        </div>

        <!-- OVERLAY PHẢI (Hiện khi người dùng đang ở tab ĐĂNG NHẬP bên trái) -->
        <div class="overlay-panel overlay-right">
          <div class="floating-ball-badge">
            <div class="spinning-pickleball"></div>
            <span style="font-size:0.74rem;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:#FFF;">4 Sân Chuẩn USAPA · LED 1000 Lux</span>
          </div>

          <div>
            <h2 class="overlay-headline">Bùng Nổ Năng Lượng Cùng <em>Spike Arena</em></h2>
            <p class="overlay-desc">
              Gia nhập cộng đồng hơn 1,250+ tay vợt Pickleball. Đặt lịch trong 15 giây, tự động giữ sân không lo trùng giờ và hưởng đặc quyền Hội viên Vàng.
            </p>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.65rem;">
              <div style="background:rgba(9,13,22,0.68);border:1px solid rgba(255,255,255,0.14);padding:0.65rem;border-radius:12px;">
                <div style="font-family:var(--font-display);font-size:1.2rem;font-weight:800;color:var(--auth-neon-volt);">-15%</div>
                <div style="font-size:0.68rem;color:#CBD5E1;">Ưu đãi Hội viên</div>
              </div>
              <div style="background:rgba(9,13,22,0.68);border:1px solid rgba(255,255,255,0.14);padding:0.65rem;border-radius:12px;">
                <div style="font-family:var(--font-display);font-size:1.2rem;font-weight:800;color:var(--auth-neon-orange);">100%</div>
                <div style="font-size:0.68rem;color:#CBD5E1;">Vé QR tự động</div>
              </div>
              <div style="background:rgba(9,13,22,0.68);border:1px solid rgba(255,255,255,0.14);padding:0.65rem;border-radius:12px;">
                <div style="font-family:var(--font-display);font-size:1.2rem;font-weight:800;color:#38BDF8;">06h–22h</div>
                <div style="font-size:0.68rem;color:#CBD5E1;">Mở cửa mỗi ngày</div>
              </div>
            </div>
          </div>

          <div class="overlay-switch-card">
            <div style="font-size:0.8rem;color:#E2E8F0;font-weight:600;">Chưa có tài khoản đặt sân tại CLB?</div>
            <button type="button" class="btn-overlay-switch" onclick="switchAuthMode('register')">
              <span>Đăng ký Hội viên Mới</span>
              <iconify-icon icon="lucide:arrow-right" width="18"></iconify-icon>
            </button>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- MODAL KHÔI PHỤC MẬT KHẨU -->
  <div class="modal-backdrop" id="forgotPasswordModal">
    <div class="modal" style="max-width: 420px; color: #0F172A;">
      <div class="modal-header">
        <h3 class="modal-title">Khôi phục mật khẩu</h3>
        <button class="modal-close" onclick="closeModal('forgotPasswordModal')">✕</button>
      </div>
      <div class="modal-body flex-col gap-3">
        <p class="text-xs text-muted">Nhập Email hoặc Số điện thoại đã đăng ký. Hệ thống sẽ gửi mã OTP 6 chữ số để đặt lại mật khẩu mới.</p>
        <div class="form-group">
          <label class="form-label">Email hoặc Số điện thoại</label>
          <input type="text" id="resetEmailInput" class="form-input" placeholder="VD: khachhang@@pickleball.vn">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal('forgotPasswordModal')">Đóng</button>
        <button class="btn btn-primary" onclick="handleResetPassword()">Gửi mã OTP</button>
      </div>
    </div>
  </div>

  <script src="/js/shared.js"></script>
  <script>
    /* ==========================================================================
       1. INTERACTIVE MASCOT CONTROLLER (EYE TRACKING & PADDLE SHIELD)
       ========================================================================== */
    const mascotBox = document.getElementById('mascotBox');
    const mascotHead = document.getElementById('mascotHeadGroup');
    const mascotEyes = document.getElementById('mascotEyesGroup');
    const mascotMouth = document.getElementById('mascotMouth');
    const mascotSpeech = document.getElementById('mascotSpeechText');
    const mascotStateLabel = document.getElementById('mascotStateLabel');

    let isPasswordFocused = false;
    let isPasswordPeeking = false;

    function setMascotState(state, speech, label) {
      if (!mascotBox) return;
      mascotBox.setAttribute('data-state', state);
      if (speech && mascotSpeech) mascotSpeech.textContent = speech;
      if (label && mascotStateLabel) mascotStateLabel.textContent = label;

      if (mascotMouth) {
        if (state === 'error') {
          mascotMouth.setAttribute('d', 'M44 62Q50 57 56 62');
        } else if (state === 'success') {
          mascotMouth.setAttribute('d', 'M42 58Q50 67 58 58');
        } else {
          mascotMouth.setAttribute('d', 'M44 60Q50 64 56 60');
        }
      }
    }

    // Track mouse movement subtly when in idle state
    document.addEventListener('mousemove', (e) => {
      if (isPasswordFocused || !mascotHead || !mascotEyes) return;
      const rect = mascotBox.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;

      const deltaX = Math.max(-1, Math.min(1, (e.clientX - centerX) / 280));
      const deltaY = Math.max(-1, Math.min(1, (e.clientY - centerY) / 280));

      mascotHead.style.transform = `translate(${deltaX * 4}px, ${deltaY * 3}px) rotate(${deltaX * 4}deg)`;
      mascotEyes.style.transform = `translate(${deltaX * 6}px, ${deltaY * 4.5}px)`;
    });

    function onEmailFocus() {
      isPasswordFocused = false;
      setMascotState('idle', 'Đang đọc địa chỉ Email / Số điện thoại của bạn...', 'ACE BOT · ĐANG QUÉT ID');
      onEmailInput(document.getElementById('loginEmail')?.value || '');
    }

    function onEmailInput(val) {
      if (!mascotHead || !mascotEyes) return;
      const progress = Math.min(1, (val || '').length / 24);
      const lookX = -6 + progress * 12;
      const lookY = 3;
      mascotHead.style.transform = `translate(${lookX * 0.45}px, 2px) rotate(${lookX * 0.4}deg)`;
      mascotEyes.style.transform = `translate(${lookX}px, ${lookY}px)`;
    }

    function onPasswordFocus() {
      isPasswordFocused = true;
      const passInput = document.getElementById('loginPassword');
      const isShowing = passInput && passInput.type === 'text';
      if (isShowing) {
        setMascotState('peek', 'Suỵt! Mình chỉ hé nhìn qua lỗ vợt 1 chút thôi nhé!', 'ACE BOT · HÉ NHÌN MẬT KHẨU');
      } else {
        setMascotState('password', 'Yên tâm! Mình đã đưa vợt Carbon lên che kín mắt rồi!', 'ACE BOT · BẢO MẬT TUYỆT ĐỐI');
      }
    }

    function onInputBlur() {
      setTimeout(() => {
        const active = document.activeElement;
        if (active && (active.id === 'loginPassword' || active.id === 'loginEmail')) return;
        isPasswordFocused = false;
        setMascotState('idle', 'Sẵn sàng xác thực đưa bạn vào sân thi đấu!', 'ACE BOT · TRỢ LÝ SÂN ĐẤU');
      }, 120);
    }

    /* ==========================================================================
       2. BACKGROUND INTERACTIVE PICKLEBALL CANVAS
       ========================================================================== */
    (function initArenaCanvas() {
      const canvas = document.getElementById('loginArenaCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let w = canvas.width = window.innerWidth;
      let h = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        w = canvas.width = window.innerWidth;
        h = canvas.height = window.innerHeight;
      });

      const nodes = Array.from({ length: 26 }, (_, i) => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.7,
        vy: (Math.random() - 0.5) * 0.7,
        r: i % 5 === 0 ? 5.5 : 2.4,
        color: i % 5 === 0 ? '#D4FF00' : i % 3 === 0 ? '#FF5520' : '#38BDF8'
      }));

      function draw() {
        ctx.clearRect(0, 0, w, h);
        for (let i = 0; i < nodes.length; i++) {
          const p = nodes[i];
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = p.r > 4 ? 0.55 : 0.3;
          ctx.fill();

          for (let j = i + 1; j < nodes.length; j++) {
            const q = nodes[j];
            const dist = Math.hypot(p.x - q.x, p.y - q.y);
            if (dist < 155) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(q.x, q.y);
              ctx.strokeStyle = '#D4FF00';
              ctx.globalAlpha = (1 - dist / 155) * 0.08;
              ctx.lineWidth = 1;
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(draw);
      }
      draw();
    })();

    /* ==========================================================================
       3. AUTHENTICATION & SLIDING PANEL LOGIC
       ========================================================================== */
    let currentAuthMode = 'login';
    let redirectTargetUrl = '';

    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      redirectTargetUrl = params.get('redirect') || '';
      const requestedMode = params.get('mode') || '';
      const noticeMsg = params.get('notice') || '';

      const session = getAuthSession();
      if (session && session.loggedIn) {
        const banner = document.getElementById('activeSessionBanner');
        const nameEl = document.getElementById('activeSessionName');
        const roleEl = document.getElementById('activeSessionRole');
        if (banner && nameEl && roleEl) {
          banner.style.display = 'flex';
          nameEl.textContent = session.name;
          roleEl.textContent = session.roleLabel;
        }
      }

      if (noticeMsg) {
        const alertBox = document.getElementById('redirectAlert');
        const alertText = document.getElementById('redirectAlertText');
        if (alertBox && alertText) {
          alertBox.style.display = 'flex';
          alertText.textContent = noticeMsg;
        }
      }

      if (requestedMode === 'register') {
        switchAuthMode('register');
      }
    });

    function switchAuthMode(mode) {
      currentAuthMode = mode === 'register' ? 'register' : 'login';
      const stageBox = document.getElementById('authStageBox');
      const mobLogin = document.getElementById('mobTabLogin');
      const mobReg = document.getElementById('mobTabRegister');

      hideLoginError();

      if (currentAuthMode === 'register') {
        stageBox.classList.add('right-panel-active');
        if (mobLogin) mobLogin.classList.remove('active');
        if (mobReg) mobReg.classList.add('active');
      } else {
        stageBox.classList.remove('right-panel-active');
        if (mobReg) mobReg.classList.remove('active');
        if (mobLogin) mobLogin.classList.add('active');
      }
    }

    function toggleAnimatedPassword(inputId, iconId) {
      const passInput = document.getElementById(inputId);
      const eyeIcon = document.getElementById(iconId);
      if (!passInput) return;

      if (passInput.type === 'password') {
        passInput.type = 'text';
        if (eyeIcon) eyeIcon.setAttribute('icon', 'lucide:eye-off');
        if (inputId === 'loginPassword') {
          isPasswordFocused = true;
          setMascotState('peek', 'Suỵt! Mình chỉ hé mắt qua lỗ vợt kiểm tra giúp bạn thôi!', 'ACE BOT · ĐANG HÉ NHÌN');
        }
      } else {
        passInput.type = 'password';
        if (eyeIcon) eyeIcon.setAttribute('icon', 'lucide:eye');
        if (inputId === 'loginPassword') {
          isPasswordFocused = true;
          setMascotState('password', 'Đã che kín mắt bằng vợt Carbon Pro!', 'ACE BOT · BẢO MẬT TUYỆT ĐỐI');
        }
      }
    }

    function updatePasswordStrength(val) {
      const segs = [
        document.getElementById('passSeg1'),
        document.getElementById('passSeg2'),
        document.getElementById('passSeg3'),
        document.getElementById('passSeg4')
      ];
      const lbl = document.getElementById('passStrengthLabel');
      if (!lbl || segs.some(s => !s)) return;

      let score = 0;
      if (val.length >= 6) score++;
      if (val.length >= 8 && /[A-Z]/.test(val)) score++;
      if (/\d/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val) || val.length >= 10) score++;

      const colors = ['rgba(255,255,255,0.12)', '#EF4444', '#F59E0B', '#10B981', '#D4FF00'];
      const labels = ['Chưa nhập', 'Yếu (Cần ít nhất 6 ký tự)', 'Trung bình', 'Mạnh', 'Rất mạnh & An toàn'];

      segs.forEach((s, idx) => {
        s.style.background = idx < score ? colors[score] : 'rgba(255,255,255,0.12)';
      });
      lbl.textContent = 'Độ mạnh mật khẩu: ' + (val.length === 0 ? labels[0] : labels[score] || labels[1]);
    }

    function showFieldError(fieldId, message) {
      const wrap = document.getElementById('fieldWrap' + fieldId.charAt(0).toUpperCase() + fieldId.slice(1));
      const errEl = document.getElementById(fieldId + 'Error');
      if (wrap) wrap.classList.add('has-error');
      if (errEl && message) errEl.textContent = message;
    }

    function clearFieldError(fieldId) {
      const wrap = document.getElementById('fieldWrap' + fieldId.charAt(0).toUpperCase() + fieldId.slice(1));
      if (wrap) wrap.classList.remove('has-error');
    }

    function showLoginError(message, isRegister = false) {
      const stageBox = document.getElementById('authStageBox');
      if (stageBox) {
        stageBox.classList.remove('shake-error');
        void stageBox.offsetWidth;
        stageBox.classList.add('shake-error');
      }
      setMascotState('error', message, 'ACE BOT · CẢNH BÁO XÁC THỰC');

      const boxId = isRegister ? 'registerErrorAlert' : 'loginErrorAlert';
      const txtId = isRegister ? 'registerErrorText' : 'loginErrorText';
      const box = document.getElementById(boxId);
      const txt = document.getElementById(txtId);
      if (box && txt) {
        txt.textContent = message;
        box.style.display = 'flex';
      }
    }

    function hideLoginError() {
      const b1 = document.getElementById('loginErrorAlert');
      const b2 = document.getElementById('registerErrorAlert');
      if (b1) b1.style.display = 'none';
      if (b2) b2.style.display = 'none';
    }

    async function triggerAnimatedLogin(emailVal, passVal) {
      const btn = document.getElementById('btnSubmitLogin');
      const btnTxt = document.getElementById('btnSubmitLoginText');
      if (btn) btn.classList.add('loading');
      if (btnTxt) btnTxt.textContent = 'Đang xác thực tài khoản...';
      setMascotState('success', 'Đang xác thực thông tin đăng nhập...', 'ACE BOT · ĐANG XÁC THỰC');

      const res = await login(emailVal, passVal, redirectTargetUrl);
      if (!res || !res.ok) {
        if (btn) btn.classList.remove('loading');
        if (btnTxt) btnTxt.textContent = 'Đăng nhập vào Sân Đấu';
        showLoginError((res && res.error) || 'Thông tin đăng nhập không chính xác.', false);
      }
    }

    function handleFormLogin(event) {
      event.preventDefault();
      hideLoginError();

      const emailVal = document.getElementById('loginEmail').value.trim();
      const passVal = document.getElementById('loginPassword').value.trim();
      let hasError = false;

      if (!emailVal || emailVal.length < 3) {
        showFieldError('loginEmail', 'Vui lòng nhập Tên đăng nhập, Email hoặc Số điện thoại.');
        hasError = true;
      }

      if (!passVal || passVal.length < 6) {
        showFieldError('loginPassword', 'Mật khẩu phải có tối thiểu 6 ký tự.');
        hasError = true;
      }

      if (hasError) {
        showLoginError('Vui lòng kiểm tra lại thông tin được đánh dấu đỏ.', false);
        return;
      }

      triggerAnimatedLogin(emailVal, passVal);
    }

    function handleSocialLogin(provider) {
      setMascotState('idle', `Vui lòng hoàn tất thông tin Hội viên lần đầu khi liên kết với ${provider}!`, `ACE BOT · LIÊN KẾT ${provider.toUpperCase()}`);
      showToast(`Liên kết ${provider}`, `Vui lòng nhập Họ tên & Số điện thoại để hoàn tất đăng ký qua ${provider}.`, 'info');
      switchAuthMode('register');
    }

    async function handleFormRegister(event) {
      event.preventDefault();
      hideLoginError();

      const fullName = document.getElementById('regFullName').value.trim();
      const phone = document.getElementById('regPhone').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const password = document.getElementById('regPassword').value;
      const confirmPassword = document.getElementById('regConfirmPassword').value;
      const agreeTerms = document.getElementById('regAgreeTerms').checked;

      let hasError = false;

      if (!fullName || fullName.length < 2) {
        showFieldError('regFullName', 'Nhập họ và tên đầy đủ.');
        hasError = true;
      }

      if (!/^[0-9]{9,11}$/.test(phone.replace(/\s+/g, ''))) {
        showFieldError('regPhone', 'SĐT gồm 9–11 chữ số.');
        hasError = true;
      }

      if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
        showFieldError('regEmail', 'Địa chỉ Email không hợp lệ.');
        hasError = true;
      }

      if (!password || password.length < 6) {
        showFieldError('regPassword', 'Tối thiểu 6 ký tự.');
        hasError = true;
      }

      if (!confirmPassword || confirmPassword !== password) {
        showFieldError('regConfirmPassword', 'Mật khẩu xác nhận không khớp.');
        hasError = true;
      }

      if (hasError) {
        showLoginError('Vui lòng điền đầy đủ và chính xác các trường thông tin.', true);
        return;
      }

      if (!agreeTerms) {
        showLoginError('Vui lòng đồng ý với Quy chế Sân đấu & Chính sách CLB.', true);
        return;
      }

      const res = await registerUser({ name: fullName, phone, email, password }, redirectTargetUrl);
      if (!res || !res.ok) {
        showLoginError((res && res.error) || 'Không thể đăng ký tài khoản.', true);
      }
    }

    function handleResetPassword() {
      const val = document.getElementById('resetEmailInput').value.trim();
      if (!val) {
        showToast('Thiếu thông tin', 'Vui lòng nhập Email hoặc SĐT cần khôi phục.', 'warning');
        return;
      }
      closeModal('forgotPasswordModal');
      showToast('Đã gửi mã OTP', `Hướng dẫn đặt lại mật khẩu đã được gửi tới ${val}.`, 'success');
    }
  </script>
</body>
