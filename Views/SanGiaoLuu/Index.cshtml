@using System.Text.Json
@model PickleballClub.Services.SocialCourtSnapshotDto
@{
    ViewData["Title"] = "Sân Giao Lưu — Spike Pickleball Club";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var bootstrapJson = JsonSerializer.Serialize(new
    {
        myProfile = Model.MyProfile,
        players = Model.Players,
        totalCount = Model.TotalCount
    }, jsonOpts);
}

<link rel="stylesheet" href="~/css/pages/san-giao-luu.css" asp-append-version="true" />

<section class="page-hero">
    <div class="container">
        <div class="page-hero-inner">
            <div>
                <h1 class="page-hero-title">Sân giao lưu hội viên</h1>
                <p class="page-hero-sub">Gặp gỡ hội viên cùng trình độ qua nhân vật pixel đồng bộ từ Hồ sơ cá nhân và hẹn lịch giao lưu trước khi đặt sân chính thức.</p>
            </div>
            <div class="sgl-hero-actions">
                <span class="badge badge-success" id="visibleCountBadge">@Model.Players.Count hội viên trên sân</span>
                <button type="button" class="btn btn-secondary btn-sm" id="openSocialSettingsBtn">
                    <iconify-icon icon="lucide:sliders-horizontal" width="15"></iconify-icon>
                    <span>Hồ sơ giao lưu của tôi</span>
                </button>
                <button type="button" class="btn btn-primary btn-sm" id="findMatchBtn">
                    <iconify-icon icon="lucide:sparkles" width="15"></iconify-icon>
                    <span>Tìm người hợp trình</span>
                </button>
            </div>
        </div>
    </div>
</section>

<main class="page-main sgl-main">
    <div class="container">
        <div class="sgl-layout">
            <div class="sgl-col-main">
                <!-- 1. Sân Pickleball Pixel Tương Tác -->
                <div class="card sgl-court-card">
                    <div class="card-header sgl-court-head">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:users" width="17" style="color:var(--brand-primary);"></iconify-icon>
                            <span>Không gian Sân giao lưu</span>
                        </span>
                        <span class="text-xs" style="color:var(--text-muted);">Nhấn vào nhân vật để mở thẻ hồ sơ hoặc nhấn Esc để đóng</span>
                    </div>

                    <div class="sgl-court-stage" id="courtStage" aria-label="Sân Pickleball giao lưu">
                        <canvas class="sgl-court-backdrop" id="courtMapCanvas" aria-hidden="true"></canvas>

                        <div class="sgl-court-actors" id="courtActors"></div>

                        <div class="sgl-court-empty" id="courtEmptyState" @(Model.Players.Count > 0 ? "hidden" : "")>
                            <div class="sgl-court-empty-box">
                                <h3>Sân giao lưu đang sẵn sàng đón bạn</h3>
                                <p>Theo mặc định, hồ sơ hội viên được giữ riêng tư. Hãy bật hiển thị để nhân vật pixel đồng bộ từ ảnh đại diện của bạn xuất hiện trên sân.</p>
                                <button type="button" class="btn btn-primary btn-sm" id="emptyEnableCourtBtn">Bật hiển thị trên sân</button>
                            </div>
                        </div>
                    </div>

                    <div class="sgl-pose-bar">
                        <div class="sgl-pose-group">
                            <span class="sgl-pose-label">Thử động tác:</span>
                            <button type="button" class="sgl-pose-btn is-active" data-pose="idle">Đứng</button>
                            <button type="button" class="sgl-pose-btn" data-pose="walk">Đi bộ</button>
                            <button type="button" class="sgl-pose-btn" data-pose="wave">Vẫy tay</button>
                            <button type="button" class="sgl-pose-btn" data-pose="swing">Vung vợt</button>
                        </div>
                        <button type="button" class="sgl-pose-btn sgl-auto-btn is-active" id="autoRoamToggle" aria-pressed="true">Tự hoạt động</button>
                    </div>
                </div>

                <!-- 2. Gợi ý đối thủ hợp trình -->
                <div class="card" id="matchPanel" hidden>
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:sparkles" width="17" style="color:var(--brand-primary);"></iconify-icon>
                            <span>Gợi ý đối thủ hợp trình</span>
                        </span>
                        <button type="button" class="btn btn-ghost btn-xs" id="closeMatchPanel" aria-label="Đóng gợi ý">Đóng</button>
                    </div>
                    <div class="card-body">
                        <div class="sgl-match-grid" id="matchGrid"></div>
                    </div>
                </div>

                <!-- 3. Quản lý lời mời giao lưu -->
                <div class="card">
                    <div class="card-header" style="flex-wrap:wrap;gap:10px;">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:calendar-heart" width="17" style="color:var(--brand-primary);"></iconify-icon>
                            <span>Lời mời giao lưu</span>
                        </span>
                        <div class="sgl-tabs" role="tablist">
                            <button type="button" class="sgl-tab-btn is-active" id="tabReceivedInvites" role="tab">
                                Lời mời đến <span class="badge badge-success" id="receivedInvitesBadge" hidden>0</span>
                            </button>
                            <button type="button" class="sgl-tab-btn" id="tabSentInvites" role="tab">Đã gửi</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="sgl-invite-list" id="invitesContainer">
                            <p class="text-sm" style="color:var(--text-muted);margin:0;">Đang tải danh sách lời mời...</p>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="sgl-col-side">
                <!-- 4. Danh sách hội viên trên sân -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:search" width="16" style="color:var(--brand-primary);"></iconify-icon>
                            <span>Hội viên trên sân</span>
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="sgl-filter-row">
                            <input type="search" id="searchMembers" class="form-input" placeholder="Tìm theo tên, trình độ, giờ rảnh..." aria-label="Tìm hội viên trên sân">
                            <button type="button" class="sgl-pose-btn" id="readyOnlyFilter" aria-pressed="false" title="Chỉ lọc người đang sẵn sàng giao lưu">Sẵn sàng</button>
                        </div>
                        <div class="sgl-member-list" id="memberList"></div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</main>

<!-- Dialog: Thẻ hồ sơ hội viên khi bấm nhân vật / danh sách / gợi ý -->
<div class="sgl-modal-backdrop" id="memberProfileModal" hidden role="dialog" aria-modal="true" aria-labelledby="memberProfileTitle">
    <div class="sgl-profile-modal" id="memberProfileDialogCard">
        <div class="sgl-profile-banner">
            <button type="button" class="sgl-profile-close" id="closeMemberProfileBtn" aria-label="Đóng thẻ hồ sơ">&times;</button>
        </div>
        <div class="sgl-profile-avatar-overlap">
            <img id="memberCardAvatar" src="" alt="" />
        </div>
        <div class="sgl-profile-content" id="memberCardBody"></div>
    </div>
</div>

<!-- Modal: Cài đặt hồ sơ giao lưu của tôi -->
<div class="sgl-modal-backdrop" id="socialSettingsModal" hidden role="dialog" aria-modal="true" aria-labelledby="socialSettingsTitle">
    <div class="sgl-modal">
        <div class="sgl-modal-header">
            <strong id="socialSettingsTitle" style="font-size:1.05rem;color:var(--text-primary);">Hồ sơ Sân giao lưu của tôi</strong>
            <button type="button" class="btn btn-ghost btn-xs" data-close-settings aria-label="Đóng cửa sổ">Đóng</button>
        </div>

        <div class="sgl-modal-body">
            <label class="sgl-switch-card">
                <span>
                    <strong>Hiển thị trên Sân giao lưu</strong>
                    <span>Cho phép hội viên khác nhìn thấy bạn (chỉ hiển thị tên, thông số thi đấu, khung giờ rảnh và nhân vật pixel).</span>
                </span>
                <input type="checkbox" id="optVisibleOnCourt">
            </label>

            <label class="sgl-switch-card">
                <span>
                    <strong>Trạng thái Sẵn sàng giao lưu</strong>
                    <span>Hiện chấm xanh và nhãn Sẵn sàng giao lưu để mọi người biết bạn đang muốn hẹn trận.</span>
                </span>
                <input type="checkbox" id="optReadyToPlay">
            </label>

            <label class="sgl-switch-card">
                <span>
                    <strong>Cho phép xuất hiện trong gợi ý hợp trình</strong>
                    <span>Hỗ trợ ghép cặp nhanh theo trình độ tự khai và khung giờ rảnh trùng nhau.</span>
                </span>
                <input type="checkbox" id="optAllowMatchSuggestion">
            </label>

            <div>
                <label class="form-label">Nhân vật pixel đồng bộ từ Hồ sơ cá nhân</label>
                <div class="sgl-avatar-sync-card">
                    <div class="sgl-avatar-sync-media">
                        <div class="sgl-avatar-sync-thumbs">
                            <div class="sgl-portrait">
                                <img id="syncProfileAvatarImg" src="/assets/san-giao-luu/@(Model.MyProfile.SpriteId)-profile.webp" alt="Ảnh đại diện hiện tại">
                            </div>
                            <div class="sgl-portrait" title="Nhân vật pixel trên sân">
                                <img id="syncPixelSpriteImg" src="/assets/san-giao-luu/@(Model.MyProfile.SpriteId)-profile.webp" alt="Nhân vật pixel đồng bộ">
                            </div>
                        </div>
                        <div>
                            <strong id="syncAvatarModeLabel" style="display:block;font-size:0.875rem;color:var(--text-primary);">Đồng bộ theo ảnh đại diện</strong>
                            <span style="display:block;font-size:0.8rem;color:var(--text-muted);">Đổi ảnh mẫu hoặc tải ảnh riêng tại Hồ sơ cá nhân để cập nhật nhân vật trên sân.</span>
                        </div>
                    </div>
                    <a href="/Account/Profile" class="btn btn-secondary btn-xs">Đổi ảnh trong Hồ sơ cá nhân</a>
                </div>
            </div>

            <div class="sgl-switch-card" style="flex-direction:column;align-items:stretch;">
                <label style="display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;">
                    <span>
                        <strong>Xác nhận trình độ tự khai</strong>
                        <span>Nếu chưa bật, hệ thống hiển thị “Chưa xác nhận trình độ” thay vì dùng mặc định.</span>
                    </span>
                    <input type="checkbox" id="optSkillConfirmed">
                </label>
                <select id="optConfirmedSkillLevel" class="form-select" style="margin-top:8px;">
                    @foreach (var sk in PickleballClub.Services.SocialCourtService.ValidSkillLevels)
                    {
                        <option value="@sk">@sk</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Khung giờ thường rảnh</label>
                <div class="sgl-slot-chips">
                    @foreach (var slot in PickleballClub.Services.SocialCourtService.ValidFreeSlots)
                    {
                        <button type="button" class="sgl-slot-chip" data-slot="@slot">@slot</button>
                    }
                </div>
            </div>
        </div>

        <div class="sgl-modal-footer">
            <button type="button" class="btn btn-ghost btn-sm" data-close-settings>Hủy</button>
            <button type="button" class="btn btn-primary btn-sm" id="saveSocialSettingsBtn">Lưu thay đổi</button>
        </div>
    </div>
</div>

<div class="sgl-toast" id="sglToast" role="status" aria-live="polite" hidden></div>

<script>
    window.__SGL_BOOTSTRAP__ = @Html.Raw(bootstrapJson);
</script>
<script src="~/js/san-giao-luu-engine.js" asp-append-version="true"></script>
<script src="~/js/san-giao-luu-page.js" asp-append-version="true"></script>
