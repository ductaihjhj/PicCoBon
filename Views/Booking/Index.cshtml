@model IEnumerable<PickleballClub.Models.TbCourt>
@{
    ViewData["Title"] = "Đặt Sân Trực Tuyến — Spike Pickleball Club";
}

<section class="page-hero">
    <div class="container page-hero-inner">
        <div>
            <span class="section-kicker" style="color:var(--color-volt);">Đặt lịch trực tuyến 24/7</span>
            <h1 class="page-hero-title">Đặt Sân Thi Đấu Pickleball</h1>
            <p class="page-hero-sub">Chọn ngày, sân thi đấu và khung giờ trống — Tự động tính giá bậc thang theo từng phân đoạn 30 phút</p>
        </div>
        <div style="display:flex;gap:0.6rem;flex-wrap:wrap;">
            <span class="badge badge-success">Cấp mã vé QR định chuẩn</span>
            <span class="badge" style="background:rgba(255,255,255,0.12);color:#FFF;" id="heroPeakBadge">Giờ vàng từ 17:00</span>
        </div>
    </div>
</section>

<main class="page-main">
    <div class="container stack">
        <!-- CHỌN NGÀY THI ĐẤU -->
        <div class="card">
            <div class="card-header" style="flex-wrap:wrap;gap:0.75rem;">
                <span class="card-header-title">
                    <iconify-icon icon="lucide:calendar-days" width="18" style="color:var(--color-primary)"></iconify-icon>
                    <span>Ngày thi đấu</span>
                </span>
                <div style="display:flex;align-items:center;gap:0.65rem;flex-wrap:wrap;">
                    <span class="text-sm font-bold" id="selectedDateLabel" style="color:var(--color-indigo)">Hôm nay</span>
                    <label for="bookingDatePicker" class="sr-only">Chọn ngày trên lịch</label>
                    <input type="date" id="bookingDatePicker" class="form-input text-mono" style="width:auto;padding:0.32rem 0.65rem;font-size:0.82rem;min-height:38px;" onchange="selectBookingDate(this.value)" aria-label="Chọn ngày thi đấu trên lịch" />
                </div>
            </div>
            <div class="card-body">
                <div class="conflict-banner" id="bookingDateNotice" role="status" aria-live="polite" style="margin-bottom:0.75rem;">
                    <iconify-icon icon="lucide:info" width="16"></iconify-icon>
                    <span id="bookingDateNoticeText"></span>
                </div>
                <div class="date-strip" id="quickDateStrip" role="group" aria-label="Danh sách ngày đặt sân nhanh"></div>
            </div>
        </div>

        <!-- BỐ CỤC 2 CỘT: CHỌN SÂN & GIỜ | HÓA ĐƠN ĐẶT SÂN -->
        <div class="col-main-aside">
            <div class="stack">
                <!-- CHỌN SÂN -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:map-pin" width="18" style="color:var(--color-indigo)"></iconify-icon>
                            <span>Sân thi đấu</span>
                        </span>
                        <span class="text-xs text-muted">Sân Indoor VIP (<span data-cms="vipSurchargeFormatted">+20.000 đ/h</span>) — Sân Outdoor (Tiêu chuẩn)</span>
                    </div>
                    <div class="card-body">
                        <div class="court-options" id="courtOptions" role="radiogroup" aria-label="Chọn sân thi đấu"></div>
                    </div>
                </div>

                <!-- THỜI LƯỢNG & KHUNG GIỜ -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:clock" width="18" style="color:var(--color-primary)"></iconify-icon>
                            <span>Thời lượng &amp; Khung giờ bắt đầu</span>
                        </span>
                        <span class="badge badge-primary" id="bookingCourtPriceBadge">120.000 đ / giờ</span>
                    </div>
                    <div class="card-body stack">
                        <div>
                            <label class="form-label mb-sm" style="display:block">Thời lượng thuê sân:</label>
                            <div class="duration-pills" id="durationPills">
                                <button type="button" class="duration-pill" onclick="setDuration(60)" data-dur="60">60 phút (1h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(90)" data-dur="90">90 phút (1.5h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(120)" data-dur="120">120 phút (2h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(180)" data-dur="180">180 phút (3h)</button>
                            </div>
                        </div>

                        <div>
                            <div class="flex-between mb-sm" style="flex-wrap:wrap;gap:0.5rem;">
                                <span class="form-label">Biểu đồ lấp đầy sân trong khung giờ mở cửa:</span>
                                <div style="display:flex;gap:0.75rem;flex-wrap:wrap;font-size:0.75rem;color:var(--text-secondary)">
                                    <span><strong style="color:var(--color-success)">●</strong> Trống</span>
                                    <span><strong style="color:var(--color-indigo)">●</strong> Đã đặt</span>
                                    <span><strong style="color:var(--color-warning)">●</strong> Chờ duyệt</span>
                                    <span><strong style="color:var(--color-danger)">●</strong> Bảo trì</span>
                                </div>
                            </div>
                            <div class="timeline-widget">
                                <div class="timeline-bar" id="bookingTimeline"></div>
                                <div class="timeline-ticks" id="bookingTicks"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex-between mb-sm" style="flex-wrap:wrap;gap:0.5rem;">
                                <span class="form-label">Chọn giờ bắt đầu (Theo giờ hoạt động CLB):</span>
                                <select class="form-select" id="bookingStart" style="width:auto;padding:0.3rem 0.75rem;font-size:0.8rem" onchange="selectStartTime(this.value)"></select>
                            </div>
                            <div class="slot-grid" id="timeSlotGrid"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: PHIẾU XÁC NHẬN & CHIA TIỀN -->
            <div class="card sticky-panel">
                <div class="card-header" style="background:#0B111E;color:#FFFFFF;flex-wrap:wrap;gap:0.5rem;">
                    <span class="card-header-title" style="color:#FFFFFF;">
                        <iconify-icon icon="lucide:receipt" width="18" style="color:var(--color-volt)"></iconify-icon>
                        <span id="bookingFormTitle">Phiếu đặt sân</span>
                    </span>
                    <button type="button" id="bookingQuoteSourceBadge" class="badge quote-source-badge" onclick="retryServerQuote()" style="background:rgba(216,248,38,0.18);color:var(--color-volt);border:1px solid rgba(216,248,38,0.35);cursor:pointer;" title="Trạng thái xác thực báo giá từ máy chủ">
                        Đang đồng bộ giá...
                    </button>
                </div>

                <div class="card-body">
                    <div class="form-group">
                        <label class="form-label" for="bookingName">Họ và tên người đặt *</label>
                        <input class="form-input" type="text" id="bookingName" placeholder="Nhập họ và tên của bạn">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="bookingPhone">Số điện thoại liên hệ *</label>
                        <input class="form-input text-mono" type="tel" id="bookingPhone" placeholder="VD: 0901234567">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="bookingPlayers">Số người chơi</label>
                            <select class="form-select" id="bookingPlayers" onchange="updatePriceBreakdown(false)">
                                <option value="2">Đánh đơn (2 người)</option>
                                <option value="4" selected>Đánh đôi (4 người)</option>
                                <option value="6">Nhóm 6 người</option>
                                <option value="8">Giao lưu 8 người</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="bookingSkill">Trình độ / DUPR</label>
                            <select class="form-select" id="bookingSkill">
                                <option value="Newbie / Cơ bản">Newbie / Cơ bản</option>
                                <option value="Giao lưu (DUPR 3.0)" selected>Giao lưu (DUPR 3.0)</option>
                                <option value="Khá (DUPR 3.5+)">Khá (DUPR 3.5+)</option>
                                <option value="Bán chuyên (DUPR 4.0+)">Bán chuyên (4.0+)</option>
                            </select>
                        </div>
                    </div>

                    <div style="padding:0.65rem 0.85rem;background:#F8FAFC;border:1px solid var(--border-color);border-radius:var(--radius-xs);font-size:0.78rem;color:var(--text-secondary);">
                        <strong style="color:var(--text-primary);">Dịch vụ thuê vợt, bóng &amp; nước uống:</strong> Đặt thêm tại <a href="/Product" style="color:var(--color-primary);font-weight:700;">Cửa hàng Pro Shop</a> (kiểm tra tồn kho thật) hoặc gọi trực tiếp tại quầy POS khi nhận sân.
                    </div>

                    <div class="payment-summary mt-sm">
                        <div class="payment-line">
                            <span class="text-muted">Ngày &amp; Giờ:</span>
                            <span class="font-bold text-mono" id="summaryDateTime">--</span>
                        </div>
                        <div class="payment-line">
                            <span class="text-muted">Phân đoạn giá:</span>
                            <span class="font-semibold text-mono" id="summaryHourlyRate">--</span>
                        </div>
                        <div class="payment-line">
                            <span class="text-muted">Tiền sân (sau ưu đãi):</span>
                            <span class="font-semibold text-mono" id="summaryCourtFee">--</span>
                        </div>
                        <div class="payment-line total">
                            <span>Tổng phải thanh toán:</span>
                            <span class="text-mono" id="summaryTotal">0 đ</span>
                        </div>
                        <div class="payment-line split-bill-callout">
                            <span style="font-weight:700;font-size:0.78rem;display:inline-flex;align-items:center;gap:0.35rem;">
                                <iconify-icon icon="lucide:users" width="14"></iconify-icon>
                                <span>Ước tính chia đều (tham khảo):</span>
                            </span>
                            <span class="font-bold text-mono" id="summarySplitPerPerson">0 đ / người</span>
                        </div>
                    </div>

                    <div class="conflict-banner" id="conflictBanner">
                        <iconify-icon icon="lucide:alert-octagon" width="18"></iconify-icon>
                        <span id="conflictBannerText">Khung giờ này bị trùng lịch. Vui lòng chọn giờ khác!</span>
                    </div>

                    <button class="btn btn-primary btn-block btn-lg mt-md" id="btnSubmitBooking" onclick="submitBooking()">
                        <iconify-icon icon="lucide:check-circle-2" width="18"></iconify-icon>
                        <span>Xác nhận đặt sân &amp; Nhận mã QR</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- MODAL MÃ QR THÀNH CÔNG — PREMIUM DIGITAL TICKET (V4-QR) -->
<div class="modal-overlay" id="modalQR">
    <div class="modal" style="max-width:520px;width:94vw;">
        <div class="modal-header no-print">
            <h3 class="modal-title" style="color:var(--color-primary)">Vé Sân Điện Tử · Đặt Sân Thành Công</h3>
            <button class="modal-close" onclick="closeModal('modalQR')">✕</button>
        </div>
        <div class="modal-body" style="padding:1rem;">
            <div id="bookingDigitalTicketHost"></div>

            <!-- UI-C01: Giữ các trường text ẩn phục vụ kiểm thử tự động nhưng KHÔNG render trùng ảnh QR -->
            <div style="display:none;" aria-hidden="true">
                <div id="qrCodeBadge"></div>
                <a id="qrDownloadPngBtn" href="#"></a>
                <div id="guestAccessTokenBox"><code id="qrGuestTokenValue"></code></div>
                <span id="qrRef"></span>
                <span id="qrStatusText"></span>
                <span id="qrName"></span>
                <span id="qrDate"></span>
                <span id="qrCourt"></span>
                <span id="qrTime"></span>
                <span id="qrTotal"></span>
            </div>
        </div>
        <div class="modal-footer no-print">
            <a href="/Lookup" id="qrOpenLookupLink" class="btn btn-outline" style="flex:1">Mở trang Tra cứu</a>
            <button class="btn btn-primary" style="flex:1" onclick="closeModal('modalQR')">Hoàn tất</button>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
