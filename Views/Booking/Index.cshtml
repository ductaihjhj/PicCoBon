@using Microsoft.EntityFrameworkCore
@inject PickleballClub.Services.ClubSettingsService ClubSettingsService
@inject PickleballClub.Models.PickleballContext SsrDb
@{
    ViewData["Title"] = "Đặt Sân Trực Tuyến — Spike Pickleball Club";
    var ssrSettings = await ClubSettingsService.GetSettingsAsync(SsrDb);
    var vndFmt = new System.Globalization.NumberFormatInfo { NumberGroupSeparator = "." };
    string ssrStdPriceNum = ssrSettings.BaseCourtPrice.ToString("#,0", vndFmt);
    string ssrVipSurchargeNum = (await SsrDb.TbCourts.AsNoTracking()
        .Where(c => c.IsActive && c.Surcharge > 0)
        .Select(c => c.Surcharge)
        .FirstOrDefaultAsync()).ToString("#,0", vndFmt);
    if (ssrVipSurchargeNum == "0") ssrVipSurchargeNum = "20.000";
    string ssrVipNum = "+" + ssrVipSurchargeNum;
}

<section class="page-hero">
    <div class="container">
        <div class="page-hero-inner">
            <div>
                <h1 class="page-hero-title">Đặt sân thi đấu Pickleball</h1>
                <p class="page-hero-sub">Chọn ngày, sân thi đấu và khung giờ trống theo thời gian thực. Báo giá minh bạch theo phân đoạn 30 phút.</p>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <span class="badge badge-success">○ Vé QR định chuẩn</span>
                <span class="badge badge-neutral" id="heroPeakBadge">Giờ vàng: @ssrSettings.PeakStart – @ssrSettings.CloseTime</span>
            </div>
        </div>
    </div>
</section>

<main class="page-main" style="padding: 28px 0 72px;">
    <div class="container">
        <div class="booking-layout">
            <!-- LEFT: COURT x TIME MATRIX + SLOT PICKER -->
            <div style="display:flex;flex-direction:column;gap:20px;min-width:0;">

                <!-- 1. Date Selection -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:calendar-days" width="17" style="color:var(--brand-primary)"></iconify-icon>
                            <span>1. Ngày thi đấu</span>
                        </span>
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                            <span class="text-sm font-bold" id="selectedDateLabel" style="color:var(--brand-primary-ink);">Hôm nay</span>
                            <input type="date" id="bookingDatePicker" class="form-input text-mono" style="width:auto;min-height:36px;padding:4px 10px;font-size:0.82rem;" onchange="selectBookingDate(this.value)" aria-label="Chọn ngày thi đấu trên lịch" />
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="conflict-banner" id="bookingDateNotice" role="status" aria-live="polite" style="margin-bottom:12px;">
                            <iconify-icon icon="lucide:info" width="16"></iconify-icon>
                            <span id="bookingDateNoticeText"></span>
                        </div>
                        <div class="date-strip" id="quickDateStrip" role="group" aria-label="Danh sách ngày đặt sân nhanh"></div>
                    </div>
                </div>

                <!-- 2. Court + Duration Controls & Interactive Matrix -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:grid" width="17" style="color:var(--brand-primary)"></iconify-icon>
                            <span>2. Ma trận lịch trống theo sân</span>
                        </span>
                        <div class="sn-matrix-legend">
                            <span class="sn-matrix-legend-item" style="color:var(--status-success-text);border-color:var(--status-success-border);background:var(--status-success-bg);">○ Trống</span>
                            <span class="sn-matrix-legend-item" style="color:#FFFFFF;border-color:var(--brand-primary);background:var(--brand-primary);">● Đang chọn</span>
                            <span class="sn-matrix-legend-item" style="color:var(--status-info-text);border-color:var(--status-info-border);background:var(--status-info-bg);">■ Đã đặt</span>
                            <span class="sn-matrix-legend-item" style="color:var(--status-warning-text);border-color:var(--status-warning-border);background:var(--status-warning-bg);">◷ Giữ chỗ</span>
                            <span class="sn-matrix-legend-item" style="color:var(--status-danger-text);border-color:var(--status-danger-border);background:var(--status-danger-bg);">✕ Bảo trì</span>
                        </div>
                    </div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:16px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
                            <span class="form-label" style="margin:0;">Thời lượng chơi dự kiến:</span>
                            <div class="duration-pills" id="durationPills" style="margin:0;">
                                <button type="button" class="duration-pill" onclick="setDuration(60)" data-dur="60">60 phút (1h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(90)" data-dur="90">90 phút (1.5h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(120)" data-dur="120">120 phút (2h)</button>
                                <button type="button" class="duration-pill" onclick="setDuration(180)" data-dur="180">180 phút (3h)</button>
                            </div>
                        </div>

                        <div class="sn-booking-matrix-wrap">
                            <table class="sn-matrix-table" id="bookingCourtMatrix" aria-label="Ma trận Sân và Khung giờ"></table>
                        </div>
                    </div>
                </div>

                <!-- 3. Court Cards & Detailed Slot List -->
                <div class="card">
                    <div class="card-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:map-pin" width="17" style="color:var(--brand-primary)"></iconify-icon>
                            <span>3. Chi tiết sân &amp; Khung giờ bắt đầu</span>
                        </span>
                        <span class="badge badge-primary tabular-nums" id="bookingCourtPriceBadge">@ssrStdPriceNum đ / giờ</span>
                    </div>
                    <div class="card-body" style="display:flex;flex-direction:column;gap:18px;">
                        <div>
                            <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
                                <span class="form-label" style="margin:0;">Chọn sân thi đấu:</span>
                                <span class="text-xs" style="color:var(--text-muted);">Indoor VIP (<span data-cms="vipSurchargeFormatted">@ssrVipNum đ/h</span>)</span>
                            </div>
                            <div class="court-options" id="courtOptions" role="radiogroup" aria-label="Chọn sân thi đấu"></div>
                        </div>

                        <div class="timeline-widget">
                            <span class="form-label" style="margin-bottom:8px;">Mức độ lấp đầy sân trong ngày:</span>
                            <div class="timeline-bar" id="bookingTimeline"></div>
                            <div class="timeline-ticks" id="bookingTicks"></div>
                        </div>

                        <div>
                            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:10px;">
                                <span class="form-label" style="margin:0;">Chọn nhanh khung giờ bắt đầu:</span>
                                <select class="form-select" id="bookingStart" style="width:auto;min-height:36px;padding:4px 10px;font-size:0.82rem;" onchange="selectStartTime(this.value)"></select>
                            </div>
                            <div class="slot-grid" id="timeSlotGrid"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT: STICKY BOOKING & SUMMARY PANEL -->
            <div id="bookingFormCard">
                <div class="card sticky-panel">
                    <div class="card-header sn-summary-header">
                        <span class="card-header-title">
                            <iconify-icon icon="lucide:receipt" width="17" style="color:var(--brand-primary)"></iconify-icon>
                            <span id="bookingFormTitle">Phiếu đặt sân</span>
                        </span>
                        <button type="button" id="bookingQuoteSourceBadge" class="badge badge-success" onclick="retryServerQuote()" style="cursor:pointer;" title="Trạng thái báo giá trực tiếp từ máy chủ">
                            ✓ Báo giá máy chủ
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <label class="form-label" for="bookingName">Họ và tên người đặt *</label>
                            <input class="form-input" type="text" id="bookingName" placeholder="Nhập họ và tên của bạn">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="bookingPhone">Số điện thoại liên hệ *</label>
                            <input class="form-input text-mono" type="tel" id="bookingPhone" placeholder="VD: 0901234567">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="bookingPlayers">Số người chơi</label>
                                <select class="form-select" id="bookingPlayers" onchange="updatePriceBreakdown(false)">
                                    <option value="2">Đánh đơn (2 người)</option>
                                    <option value="4" selected>Đánh đôi (4 người)</option>
                                    <option value="6">Nhóm 6 người</option>
                                    <option value="8">Giao lưu 8 người</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="bookingSkill">Trình độ / DUPR</label>
                                <select class="form-select" id="bookingSkill">
                                    <option value="Mới chơi (2.0)">Mới chơi (2.0)</option>
                                    <option value="Giao lưu (DUPR 3.0)" selected>Giao lưu (DUPR 3.0)</option>
                                    <option value="Trung bình khá (3.5+)">Trung bình khá (3.5+)</option>
                                    <option value="Thi đấu nâng cao (4.0+)">Thi đấu nâng cao (4.0+)</option>
                                </select>
                            </div>
                        </div>

                        <div class="sn-alert sn-alert-info" style="font-size:0.78rem;padding:10px 12px;margin-bottom:14px;">
                            <iconify-icon icon="lucide:shield-check" width="16" style="flex-shrink:0;margin-top:2px;"></iconify-icon>
                            <span>Miễn phí giữ chỗ theo phiên; thanh toán trực tiếp tại quầy khi nhận sân qua QR.</span>
                        </div>

                        <div class="payment-summary" style="border-radius:var(--radius-md);">
                            <div class="payment-line">
                                <span class="text-muted">Ngày &amp; Giờ:</span>
                                <span class="font-bold text-mono tabular-nums" id="summaryDateTime">--</span>
                            </div>
                            <div class="payment-line">
                                <span class="text-muted">Phân đoạn giá:</span>
                                <span class="font-semibold text-mono tabular-nums" id="summaryHourlyRate">--</span>
                            </div>
                            <div class="payment-line">
                                <span class="text-muted">Tiền sân:</span>
                                <span class="font-semibold text-mono tabular-nums" id="summaryCourtFee">--</span>
                            </div>
                            <div class="payment-line total">
                                <span>Tổng tạm tính:</span>
                                <span class="text-mono tabular-nums" id="summaryTotal" style="color:var(--brand-primary);">0 đ</span>
                            </div>
                            <div class="payment-line split-bill-callout">
                                <span>Chia theo nhóm:</span>
                                <span class="font-bold text-mono tabular-nums" id="summarySplitPerPerson">0 đ / người</span>
                            </div>
                        </div>

                        <div class="conflict-banner mt-sm" id="conflictBanner">
                            <iconify-icon icon="lucide:alert-triangle" width="16"></iconify-icon>
                            <span id="conflictBannerText">Khung giờ này bị trùng lịch. Vui lòng chọn giờ khác.</span>
                        </div>

                        <button type="button" class="btn btn-primary btn-block btn-lg mt-md" id="btnSubmitBooking" onclick="submitBooking()">
                            <iconify-icon icon="lucide:qr-code" width="18"></iconify-icon>
                            <span>Xác nhận đặt sân &amp; Nhận vé QR</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- MOBILE STICKY SUMMARY BAR (<=1023px) -->
<div class="sn-mobile-booking-bar no-print" id="mobileBookingBar">
    <div style="min-width:0;">
        <div class="text-xs" style="color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" id="mobileBookingDateTime">Chưa chọn khung giờ</div>
        <div class="text-mono tabular-nums" style="font-weight:750;font-size:1rem;color:var(--brand-primary);" id="mobileBookingTotal">0 đ</div>
    </div>
    <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('bookingFormCard')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); document.getElementById('bookingName')?.focus();">
        <span>Điền phiếu &amp; Đặt</span>
        <iconify-icon icon="lucide:arrow-down" width="15"></iconify-icon>
    </button>
</div>

<!-- DIGITAL TICKET QR MODAL (PRESERVED SACRED CONTRACT) -->
<div class="modal-overlay" id="modalQR">
    <div class="modal" style="max-width:520px;width:94vw;">
        <div class="modal-header no-print">
            <h3 class="modal-title" id="bookingModalTitle">Vé sân điện tử QR</h3>
            <button type="button" class="modal-close" onclick="closeModal('modalQR')" aria-label="Đóng">✕</button>
        </div>
        <div class="modal-body" style="padding:16px;">
            <div id="bookingDigitalTicketHost"></div>
            <div style="display:none;" aria-hidden="true">
                <div id="qrCodeBadge"></div>
                <a id="qrDownloadPngBtn" href="#"></a>
                <div id="guestAccessTokenBox"><code id="qrGuestTokenValue"></code></div>
                <span id="qrRef"></span>
                <span id="qrStatusText"></span>
                <span id="qrName"></span>
                <span id="qrDate"></span>
                <span id="qrCourt"></span>
                <span id="qrTime"></span>
                <span id="qrTotal"></span>
            </div>
        </div>
        <div class="modal-footer no-print" style="display:flex;gap:8px;padding:12px 16px;">
            <a href="/Lookup" id="qrOpenLookupLink" class="btn btn-secondary" style="flex:1">Mở trang Tra cứu</a>
            <button type="button" class="btn btn-primary" style="flex:1" onclick="closeModal('modalQR')">Hoàn tất</button>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
