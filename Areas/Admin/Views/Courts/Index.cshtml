@model IEnumerable<PickleballClub.Models.TbCourt>
@{
    ViewData["Title"] = "Quản lý Cụm Sân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Quản lý Cụm Sân Thi Đấu</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">Thiết lập danh mục sân Indoor VIP / Outdoor, đơn giá niêm yết và trạng thái mở lịch.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <iconify-icon icon="lucide:plus" width="15"></iconify-icon>
        <span>Thêm sân thi đấu mới</span>
    </a>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Danh sách cụm sân (@Model.Count() sân)</h3>
    </div>
    <div class="sn-table-wrap">
        <table class="sn-table">
            <thead>
                <tr>
                    <th>Mã sân</th>
                    <th>Tên sân</th>
                    <th>Phân loại</th>
                    <th>Mặt sân</th>
                    <th>Giá cơ bản / giờ</th>
                    <th>Phụ thu VIP</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code class="text-mono" style="font-weight:700;color:var(--brand-primary-ink);">#@item.CourtId</code></td>
                        <td style="font-weight:650;">@item.CourtName</td>
                        <td>@(item.TypeLabel ?? item.CourtType)</td>
                        <td>@item.Surface</td>
                        <td class="text-mono tabular-nums" style="font-weight:650;color:var(--status-success-text);">@string.Format("{0:N0} đ", item.BasePrice)</td>
                        <td class="text-mono tabular-nums">@string.Format("{0:N0} đ", item.Surcharge)</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">● Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">✕ Tạm ngưng</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                <a asp-action="Edit" asp-route-id="@item.CourtId" class="btn btn-primary btn-xs">Sửa thông tin &amp; giá</a>
                                <form asp-action="ToggleActive" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CourtId" />
                                    <button type="submit" class="btn btn-secondary btn-xs">@(item.IsActive ? "Tạm ngưng" : "Kích hoạt")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
