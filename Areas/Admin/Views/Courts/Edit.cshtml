@model PickleballClub.Models.TbCourt

@{
    ViewData["Title"] = "Cập nhật Sân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Cập nhật Sân Thi Đấu</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Chỉnh sửa thông tin sân @Model.CourtName</h3>
                </div>
                <form asp-action="Edit">
                    <input type="hidden" asp-for="CourtId" />
                    <input type="hidden" asp-for="Alias" />
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="CourtName">Tên sân</label>
                            <input asp-for="CourtName" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="CourtType">Mã loại sân (indoor / vip / outdoor)</label>
                            <input asp-for="CourtType" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="TypeLabel">Nhãn hiển thị loại sân</label>
                            <input asp-for="TypeLabel" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Surface">Chất liệu mặt sân</label>
                            <input asp-for="Surface" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="BasePrice">Đơn giá cơ bản / giờ (VNĐ)</label>
                            <input asp-for="BasePrice" class="form-control" type="number" step="10000" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="Surcharge">Phụ thu sân VIP / giờ (VNĐ)</label>
                            <input asp-for="Surcharge" class="form-control" type="number" step="10000" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Image">Hình ảnh</label>
                            <input asp-for="Image" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Description">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" asp-for="IsActive" /> Đang hoạt động
                            </label>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
