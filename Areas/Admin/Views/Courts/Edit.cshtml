@model PickleballClub.Models.TbCourt
@{
    ViewData["Title"] = "Cập nhật Sân";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["AdminHeaderTitle"] = $"Cập nhật {Model.CourtName}";
    ViewData["AdminHeaderSubtitle"] = "Điều chỉnh phân loại, mặt thảm và đơn giá thuê sân theo giờ.";
    ViewData["AdminHeaderBackUrl"] = "/Admin/Courts";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminPageHeader.cshtml")

<div class="card" style="max-width:760px;">
    <div class="card-header">
        <h3 class="card-title">Thông tin sân @Model.CourtName</h3>
    </div>
    <form asp-action="Edit">
        <input type="hidden" asp-for="CourtId" />
        <input type="hidden" asp-for="Alias" />
        <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">
            <div class="form-group">
                <label class="form-label" asp-for="CourtName">Tên sân</label>
                <input asp-for="CourtName" class="form-control" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="CourtType">Mã loại sân (Indoor / Outdoor)</label>
                    <input asp-for="CourtType" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="TypeLabel">Nhãn hiển thị loại sân</label>
                    <input asp-for="TypeLabel" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Surface">Chất liệu mặt sân</label>
                <input asp-for="Surface" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="BasePrice">Đơn giá cơ bản / giờ (VNĐ)</label>
                    <input asp-for="BasePrice" class="form-control text-mono" type="number" step="10000" required />
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Surcharge">Phụ thu sân VIP / giờ (VNĐ)</label>
                    <input asp-for="Surcharge" class="form-control text-mono" type="number" step="10000" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Image">Hình ảnh</label>
                <input asp-for="Image" class="form-control text-mono" />
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Description">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> Đang hoạt động
                </label>
            </div>
            <div style="display:flex;gap:8px;padding-top:8px;">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </form>
</div>
