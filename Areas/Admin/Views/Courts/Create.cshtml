@model PickleballClub.Models.TbCourt

@{
    ViewData["Title"] = "Thêm Sân Thi Đấu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Thêm Sân Thi Đấu Mới</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Thông tin sân thi đấu mới</h3>
                </div>
                <form asp-action="Create">
                    <div class="card-body">
                        <div class="form-group">
                            <label asp-for="CourtName">Tên sân *</label>
                            <input asp-for="CourtName" class="form-control" placeholder="VD: Sân VIP 05 (Arena C)" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="CourtType">Phân loại sân</label>
                            <select asp-for="CourtType" class="form-control">
                                <option value="Indoor">Indoor (Trong nhà / Mái vòm VIP)</option>
                                <option value="Outdoor">Outdoor (Ngoài trời tiêu chuẩn)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label asp-for="TypeLabel">Mô tả không gian sân</label>
                            <input asp-for="TypeLabel" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Surface">Chất liệu mặt sân</label>
                            <input asp-for="Surface" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="BasePrice">Đơn giá cơ bản / giờ (VNĐ)</label>
                            <input asp-for="BasePrice" class="form-control" type="number" step="10000" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="Surcharge">Phụ thu sân VIP / giờ (VNĐ)</label>
                            <input asp-for="Surcharge" class="form-control" type="number" step="10000" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Image">Đường dẫn hình ảnh</label>
                            <input asp-for="Image" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="Description">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input class="form-check-input" asp-for="IsActive" checked /> Đưa vào hoạt động ngay
                            </label>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Thêm sân mới" class="btn btn-primary" />
                            <a asp-action="Index" class="btn btn-outline">Quay lại</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
