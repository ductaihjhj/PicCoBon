@model PickleballClub.Models.TbCourt
@{
    ViewData["Title"] = "Thêm Sân Thi Đấu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["AdminHeaderTitle"] = "Thêm sân thi đấu mới";
    ViewData["AdminHeaderSubtitle"] = "Khởi tạo thông tin sân, mặt thảm và đơn giá thuê theo giờ.";
    ViewData["AdminHeaderBackUrl"] = "/Admin/Courts";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminPageHeader.cshtml")

<div class="card" style="max-width:760px;">
    <div class="card-header">
        <h3 class="card-title">Thông tin sân thi đấu mới</h3>
    </div>
    <form asp-action="Create">
        <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">
            <div class="form-group">
                <label class="form-label" asp-for="CourtName">Tên sân *</label>
                <input asp-for="CourtName" class="form-control" placeholder="VD: Sân VIP 05 (Arena C)" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="CourtType">Phân loại sân</label>
                    <select asp-for="CourtType" class="form-control">
                        <option value="Indoor">Indoor (Trong nhà / Mái vòm VIP)</option>
                        <option value="Outdoor">Outdoor (Ngoài trời tiêu chuẩn)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="TypeLabel">Mô tả không gian sân</label>
                    <input asp-for="TypeLabel" class="form-control" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Surface">Chất liệu mặt sân</label>
                <input asp-for="Surface" class="form-control" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label" asp-for="BasePrice">Đơn giá cơ bản / giờ (VNĐ)</label>
                    <input asp-for="BasePrice" class="form-control text-mono" type="number" step="10000" required />
                </div>
                <div class="form-group">
                    <label class="form-label" asp-for="Surcharge">Phụ thu sân VIP / giờ (VNĐ)</label>
                    <input asp-for="Surcharge" class="form-control text-mono" type="number" step="10000" />
                </div>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Image">Đường dẫn hình ảnh</label>
                <input asp-for="Image" class="form-control text-mono" />
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Description">Mô tả chi tiết</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" checked /> Đưa vào hoạt động ngay
                </label>
            </div>
            <div style="display:flex;gap:8px;padding-top:8px;">
                <input type="submit" value="Thêm sân mới" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </form>
</div>
