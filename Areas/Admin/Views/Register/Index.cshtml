@model PickleballClub.Models.TbAccount
@{
    Layout = null;
    var authError = TempData["AuthError"] as string;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cấp Tài Khoản Nhân Sự — Spike Pickleball Workspace</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23FF5520'/%3E%3Ccircle cx='16' cy='16' r='8' fill='%23FFFFFF'/%3E%3C/svg%3E">
    @await Html.PartialAsync("~/Views/Shared/_DesignSystemCss.cshtml")
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <style>
        body.sh-auth-body {
            min-height: 100vh;
            background: var(--surface-secondary, #F6F5F4);
            color: var(--text-primary, #111827);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }
        .sh-auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--surface, #FFFFFF);
            border: 1px solid var(--border-default, #E5E7EB);
            border-radius: 12px;
            padding: 32px 28px;
            box-shadow: var(--shadow-float, 0 4px 18px rgba(0,0,0,0.06));
        }
        .sh-auth-head { text-align: center; margin-bottom: 20px; }
        .sh-auth-logo {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: var(--brand-primary, #FF5520);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }
        .sh-auth-title {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: var(--text-primary, #111827);
            margin: 0 0 4px;
        }
    </style>
</head>
<body class="sh-auth-body">
    <div class="sh-auth-card">
        <div class="sh-auth-head">
            <div class="sh-auth-logo">
                <iconify-icon icon="mdi:racquetball" width="22"></iconify-icon>
            </div>
            <h1 class="sh-auth-title">Cấp tài khoản nhân sự nội bộ</h1>
            <p class="text-xs text-muted" style="margin:0;">Chỉ Quản trị viên hệ thống mới có quyền khởi tạo tài khoản nhân sự</p>
        </div>

        <form asp-area="Admin" asp-controller="Register" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label" asp-for="FullName">Họ và tên</label>
                <input type="text" asp-for="FullName" class="form-input" placeholder="Nhập họ và tên" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Email">Email</label>
                <input type="email" asp-for="Email" class="form-input" placeholder="Nhập địa chỉ Email" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Username">Tên đăng nhập</label>
                <input type="text" asp-for="Username" class="form-input" placeholder="Tên tài khoản" required>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Phone">Số điện thoại</label>
                <input type="tel" asp-for="Phone" class="form-input" placeholder="Số điện thoại liên hệ">
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="RoleId">Vai trò phân quyền</label>
                <select asp-for="RoleId" class="form-select">
                    <option value="3">Nhân viên vận hành / Thu ngân (Staff)</option>
                    <option value="1">Quản trị viên hệ thống (Admin)</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="Password">Mật khẩu (tối thiểu 8 ký tự)</label>
                <input type="password" asp-for="Password" class="form-input" minlength="8" placeholder="Nhập mật khẩu mạnh" required>
            </div>

            @if (!string.IsNullOrEmpty(authError))
            {
                <div class="sn-alert sn-alert-danger" style="margin-bottom:14px;font-size:0.84rem;">
                    @authError
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block btn-lg">Tạo tài khoản nội bộ</button>
        </form>

        <div style="text-align:center;margin-top:18px;padding-top:14px;border-top:1px solid var(--border-default);font-size:0.82rem;">
            <a href="/Admin/Accounts" style="color:var(--brand-primary-ink);font-weight:600;text-decoration:none;">← Quay lại Quản lý Tài khoản</a>
        </div>
    </div>
</body>
</html>
