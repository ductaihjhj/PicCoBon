@model PickleballClub.Models.TbAccount
@using PickleballClub.Utilities
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tạo Tài Khoản Quản Trị — Spike Pickleball Club</title>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true">
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <style>
        body {
            min-height: 100vh;
            background: radial-gradient(circle at 20% 20%, rgba(255, 85, 32, 0.16), transparent 45%),
                        radial-gradient(circle at 80% 80%, rgba(212, 255, 0, 0.10), transparent 45%),
                        #0A0E17;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .admin-auth-card {
            width: 100%;
            max-width: 460px;
            background: #FFFFFF;
            border-radius: 20px;
            padding: 2.3rem 2.2rem;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
        }
        .admin-auth-head {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .admin-auth-logo {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: var(--color-primary, #FF5520);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
        }
        .admin-auth-title {
            font-family: var(--font-display, 'Teko', sans-serif);
            font-size: 1.9rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #0F172A;
            margin-bottom: 0.2rem;
        }
    </style>
</head>
<body>
    <div class="admin-auth-card">
        <div class="admin-auth-head">
            <div class="admin-auth-logo">
                <iconify-icon icon="mdi:racquetball" width="26"></iconify-icon>
            </div>
            <h1 class="admin-auth-title">Đăng Ký Quản Trị Viên</h1>
            <p class="text-xs text-muted">Tạo tài khoản nhân sự vận hành Spike Pickleball Club</p>
        </div>

        <form asp-controller="Register" asp-action="Index" method="post">
            <div class="form-group">
                <label class="form-label">Họ và tên</label>
                <input type="text" asp-for="FullName" class="form-input" placeholder="Nhập họ và tên" required>
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-input" placeholder="Nhập địa chỉ Email" required>
            </div>
            <div class="form-group">
                <label class="form-label">Tên đăng nhập</label>
                <input type="text" asp-for="Username" class="form-input" placeholder="Tên tài khoản" required>
            </div>
            <div class="form-group">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" asp-for="Phone" class="form-input" placeholder="Số điện thoại liên hệ">
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" asp-for="Password" class="form-input" placeholder="Nhập mật khẩu" required>
            </div>

            @if (!string.IsNullOrEmpty(Function._MessageEmail))
            {
                <div style="background:#FEE2E2;color:#DC2626;padding:0.65rem 0.9rem;border-radius:10px;font-size:0.82rem;font-weight:600;margin-bottom:1rem;">
                    @Function._MessageEmail
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block btn-lg">Đăng ký tài khoản</button>
        </form>

        <div style="text-align:center;margin-top:1.2rem;font-size:0.82rem;">
            <a href="/Admin/Login" style="color:var(--color-primary);font-weight:600;text-decoration:none;">Đã có tài khoản? Đăng nhập ngay</a>
        </div>
    </div>
</body>
</html>
