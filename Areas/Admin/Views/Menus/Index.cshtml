@model IEnumerable<PickleballClub.Models.TbMenu>

@{
    ViewData["Title"] = "Quản lý Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý Menu Điều Hướng</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin">Quản trị</a></li>
                        <li class="breadcrumb-item active">Quản lý Menu</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create" class="btn btn-success btn-sm">+ Thêm mới menu</a></h3>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tiêu đề</th>
                                        <th>Alias (Đường dẫn)</th>
                                        <th>Cấp</th>
                                        <th>Vị trí</th>
                                        <th>Hiện</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 1; }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Alias)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Levels)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Position)</td>
                                            <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.MenuId" class="btn btn-primary btn-sm">Sửa</a>
                                                <a asp-action="Details" asp-route-id="@item.MenuId" class="btn btn-info btn-sm">Chi tiết</a>
                                                <a asp-action="Delete" asp-route-id="@item.MenuId" class="btn btn-danger btn-sm">Xoá</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
