@model PickleballClub.Models.TbMenu

@{
    ViewData["Title"] = "Xoá Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xoá Menu</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md">
                    <div class="card card-danger">
                        <div class="card-header">
                            <h3 class="card-title">Xác nhận xoá menu</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label>Tiêu đề:</label> @Html.DisplayFor(model => model.Title)
                            </div>
                            <div class="form-group">
                                <label>Alias:</label> @Html.DisplayFor(model => model.Alias)
                            </div>
                            <div class="form-group">
                                <label>Vị trí:</label> @Html.DisplayFor(model => model.Position)
                            </div>
                            <form asp-action="Delete">
                                <input type="hidden" asp-for="MenuId" />
                                <input type="submit" value="Xoá" class="btn btn-danger" />
                                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
