@model PickleballClub.Models.TbMenu
@{
    ViewData["Title"] = "Xoá Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["AdminHeaderTitle"] = "Xác nhận xoá Menu";
    ViewData["AdminHeaderBackUrl"] = "/Admin/Menus";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminPageHeader.cshtml")

<div class="card card-danger" style="max-width:560px;">
    <div class="card-header">
        <h3 class="card-title">Xác nhận xoá mục menu này?</h3>
    </div>
    <div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
        <div class="payment-summary" style="border-radius:var(--radius-md);">
            <div class="payment-line"><span>Tiêu đề</span><strong>@Html.DisplayFor(model => model.Title)</strong></div>
            <div class="payment-line"><span>Alias</span><code class="text-mono">@Html.DisplayFor(model => model.Alias)</code></div>
            <div class="payment-line"><span>Vị trí</span><strong class="text-mono">@Html.DisplayFor(model => model.Position)</strong></div>
        </div>
        <form asp-action="Delete" style="display:flex;gap:8px;">
            <input type="hidden" asp-for="MenuId" />
            <input type="submit" value="Xác nhận xoá" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
