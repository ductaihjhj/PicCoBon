@model PickleballClub.Models.TbMenu
@{
    ViewData["Title"] = "Thêm Menu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["AdminHeaderTitle"] = "Thêm mục điều hướng mới";
    ViewData["AdminHeaderBackUrl"] = "/Admin/Menus";
}
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminPageHeader.cshtml")

<div class="card" style="max-width:680px;">
    <div class="card-header">
        <h3 class="card-title">Thông tin mục menu</h3>
    </div>
    <form asp-action="Create">
        <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">
            <div asp-validation-summary="ModelOnly" class="sn-alert sn-alert-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="form-label">Tiêu đề</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Alias" class="form-label">Alias (Đường dẫn)</label>
                <input asp-for="Alias" class="form-control text-mono" />
                <span asp-validation-for="Alias" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Levels" class="form-label">Cấp</label>
                    <input asp-for="Levels" class="form-control text-mono" value="1" />
                    <span asp-validation-for="Levels" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Position" class="form-label">Vị trí</label>
                    <input asp-for="Position" class="form-control text-mono" value="1" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
            </div>
            <div class="form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" checked /> Hiển thị trên thanh điều hướng
                </label>
            </div>
            <div style="display:flex;gap:8px;padding-top:8px;">
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </form>
</div>
