@{
    ViewData["Title"] = "Soát vé Check-in QR";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Trạm soát vé Check-in QR</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">Quét QR trực tiếp từ camera, tải ảnh QR lên máy chủ (ZXing) hoặc nhập mã đặt sân thủ công.</p>
    </div>
    <a href="/Management" class="btn btn-secondary btn-sm">
        <iconify-icon icon="lucide:calendar-range" width="16"></iconify-icon>
        <span>Về Điều phối Sân</span>
    </a>
</div>

<div class="checkin-layout">
    <!-- Left Column: Verification Station -->
    <div class="card">
        <div class="card-header">
            <span class="card-header-title">
                <iconify-icon icon="lucide:scan-line" width="17" style="color:var(--brand-primary)"></iconify-icon>
                <span>Xác thực vé điện tử</span>
            </span>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label class="form-label" for="manualCodeInput">Nhập mã đặt sân (PB-...) hoặc dán chuỗi QR (SPK1....)</label>
                <div style="display:flex;gap:8px;">
                    <input class="form-input text-mono" type="text" id="manualCodeInput" placeholder="VD: PB-2611A9 hoặc SPK1...." onkeydown="if(event.key==='Enter')verifyManualCode()">
                    <button class="btn btn-primary" type="button" onclick="verifyManualCode()">Kiểm tra</button>
                </div>
            </div>

            <div class="sh-subtle-panel" style="padding:14px;margin-top:14px;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
                    <span class="text-xs font-bold" style="color:var(--text-primary);display:inline-flex;align-items:center;gap:6px;">
                        <iconify-icon icon="lucide:camera" width="15" style="color:var(--brand-primary)"></iconify-icon>
                        <span>Camera quét QR trực tiếp</span>
                    </span>
                    <div style="display:flex;gap:6px;">
                        <button type="button" class="btn btn-secondary btn-xs" id="btnStartCamera" onclick="startCameraScanner()">
                            <iconify-icon icon="lucide:video" width="14"></iconify-icon>
                            <span>Bật Camera</span>
                        </button>
                        <button type="button" class="btn btn-danger btn-xs" id="btnStopCamera" style="display:none;" onclick="stopCameraScanner()">
                            <iconify-icon icon="lucide:video-off" width="14"></iconify-icon>
                            <span>Tắt Camera</span>
                        </button>
                    </div>
                </div>
                <div id="cameraStatusBanner" class="text-xs text-muted" style="margin-top:6px;">
                    Trạng thái: Chưa bật camera. Thiết bị không có camera vẫn có thể tải ảnh mã QR bên dưới.
                </div>
                <div id="cameraViewportWrap" style="display:none;margin-top:10px;text-align:center;">
                    <video id="qrCameraVideo" autoplay playsinline muted style="width:100%;max-height:220px;border-radius:8px;background:#0F172A;object-fit:cover;"></video>
                    <canvas id="qrCameraCanvas" style="display:none;"></canvas>
                    <button type="button" class="btn btn-primary btn-sm btn-block mt-sm" onclick="captureCameraFrameAndDecode()">
                        <iconify-icon icon="lucide:aperture" width="15"></iconify-icon>
                        <span>Chụp khung hình &amp; Giải mã QR</span>
                    </button>
                </div>
            </div>

            <div id="checkinUpload" style="margin-top:14px;">
                <label class="upload-area" id="qrUploadLabel" for="qrFileInput">
                    <iconify-icon icon="lucide:qr-code" width="38" style="color:var(--brand-primary);margin-bottom:6px;"></iconify-icon>
                    <div class="font-bold text-sm" style="color:var(--text-primary);">Hoặc chọn / Kéo thả ảnh QR vé sân</div>
                    <div class="text-xs text-muted mt-xs">Hỗ trợ PNG, JPG, WEBP, SVG — Giải mã an toàn qua ZXing Server</div>
                </label>
                <input type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" id="qrFileInput" style="display:none" onchange="handleQrFileSelect(event)">
            </div>

            <div class="checkin-result" id="checkinResult" style="margin-top:16px;">
                <p class="text-xl font-bold text-mono mb-sm sh-subtle-panel" id="checkinRef" style="text-align:center;padding:12px;color:var(--brand-primary);"></p>
                <div id="checkinSuccess" class="checkin-success" style="display:none">
                    <div class="font-bold text-base" id="checkinSuccessText"></div>
                </div>
                <div id="checkinError" class="checkin-error" style="display:none">
                    <div class="font-bold text-base" id="checkinErrorText">Vé không hợp lệ!</div>
                </div>
                <button class="btn btn-secondary btn-block mt-md" type="button" onclick="resetCheckIn()">Soát vé tiếp theo</button>
            </div>
        </div>
    </div>

    <!-- Right Column: Ready Check-ins Today -->
    <div class="card">
        <div class="card-header">
            <span class="card-header-title">
                <iconify-icon icon="lucide:list-checks" width="17" style="color:var(--status-success-text)"></iconify-icon>
                <span>Danh sách ca sẵn sàng Check-in hôm nay</span>
            </span>
            <span class="badge badge-primary tabular-nums" id="readyCheckinCount">0 vé</span>
        </div>
        <div class="card-body p-0" id="readyCheckinList"></div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/checkin.js" asp-append-version="true"></script>
}
