@using Microsoft.EntityFrameworkCore
@inject PickleballClub.Services.ClubSettingsService ClubSettingsService
@inject PickleballClub.Models.PickleballContext SsrDb
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cấu Hình Website & Bảng Giá (CMS)";
    var ssrSettings = await ClubSettingsService.GetSettingsAsync(SsrDb);
    var vndFmt = new System.Globalization.NumberFormatInfo { NumberGroupSeparator = "." };
    string ssrStdPriceNum = ssrSettings.BaseCourtPrice.ToString("#,0", vndFmt);
    string ssrPeakTotalNum = (ssrSettings.BaseCourtPrice + ssrSettings.PeakSurchargePerHour).ToString("#,0", vndFmt);
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Cấu hình Bảng giá, Giờ mở cửa &amp; Nội dung Website</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">Thay đổi tại đây cập nhật nguồn dữ liệu máy chủ (PricingVersion) cho toàn bộ trang Đặt sân &amp; Báo giá.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/Admin" class="btn btn-secondary btn-sm">Tổng quan</a>
        <a href="/" class="btn btn-primary btn-sm">Xem trang chủ</a>
    </div>
</div>

  <main class="page-main">
    <div class="container">
      <div class="cms-grid">
        <div class="stack">
          <div class="card">
            <div class="card-header">
              <span class="card-header-title">Nội dung Banner Trang Chủ (Hero Section)</span>
            </div>
            <div class="card-body">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="cmsHeroTag">Nhãn nổi bật (Badge Tag)</label>
                  <input class="form-input" type="text" id="cmsHeroTag" oninput="updateLivePreview()">
                </div>
                <div class="form-group">
                  <label class="form-label" for="cmsHeroSubtag">Dòng phụ giới thiệu</label>
                  <input class="form-input" type="text" id="cmsHeroSubtag" oninput="updateLivePreview()">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="cmsHeroTitle">Tiêu đề chính trang chủ</label>
                <input class="form-input" type="text" id="cmsHeroTitle" oninput="updateLivePreview()">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label" for="cmsHeroSubtitle">Mô tả chi tiết cụm sân</label>
                <input class="form-input" type="text" id="cmsHeroSubtitle" oninput="updateLivePreview()">
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <span class="card-header-title">Đơn giá thuê sân, Phụ thu Giờ vàng &amp; Giờ hoạt động</span>
            </div>
            <div class="card-body">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="cmsCourtPrice">Giá sân tiêu chuẩn (VNĐ / giờ)</label>
                  <input class="form-input text-mono font-bold" type="number" id="cmsCourtPrice" step="10000" min="20000" oninput="updateLivePreview()">
                </div>
                <div class="form-group">
                  <label class="form-label" for="cmsPeakSurcharge">Phụ thu Giờ vàng (VNĐ / giờ)</label>
                  <input class="form-input text-mono font-bold" type="number" id="cmsPeakSurcharge" step="5000" min="0" oninput="updateLivePreview()">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="cmsOpenTime">Giờ mở cửa</label>
                  <input class="form-input text-mono" type="time" id="cmsOpenTime" oninput="updateLivePreview()">
                </div>
                <div class="form-group">
                  <label class="form-label" for="cmsCloseTime">Giờ đóng cửa</label>
                  <input class="form-input text-mono" type="time" id="cmsCloseTime" oninput="updateLivePreview()">
                </div>
              </div>
              <div class="form-row">
                <div class="form-group" style="margin-bottom:0">
                  <label class="form-label" for="cmsPeakStart">Bắt đầu Khung Giờ Vàng</label>
                  <input class="form-input text-mono" type="time" id="cmsPeakStart" oninput="updateLivePreview()">
                </div>
                <div class="form-group" style="margin-bottom:0">
                  <label class="form-label" for="cmsHotline">Hotline Ban Quản Lý</label>
                  <input class="form-input text-mono" type="tel" id="cmsHotline">
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-header">
              <span class="card-header-title">Nội dung Thẻ Hội Viên CLB</span>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label class="form-label" for="cmsClubTitle">Tiêu đề khối Hội viên</label>
                <input class="form-input" type="text" id="cmsClubTitle" oninput="updateLivePreview()">
              </div>
              <div class="form-group" style="margin-bottom:0">
                <label class="form-label" for="cmsClubDesc">Quyền lợi thành viên</label>
                <textarea class="form-input" id="cmsClubDesc" rows="3" oninput="updateLivePreview()"></textarea>
              </div>
            </div>
          </div>

          <div class="card" id="cmsAiAvatarCard">
            <div class="card-header">
              <span class="card-header-title" style="display:inline-flex;align-items:center;gap:8px;">
                <iconify-icon icon="lucide:bot" width="18" style="color:var(--brand-primary);"></iconify-icon>
                <span>Hình đại diện Trợ lý AI (Spike Assistant)</span>
              </span>
              <span class="badge badge-primary">Gemini AI</span>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">
              <input type="hidden" id="cmsAssistantAvatar" value="@ssrSettings.AssistantAvatar" />

              <div class="sh-subtle-panel" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                <div style="display:flex;align-items:center;gap:12px;">
                  <div style="width:52px;height:52px;border-radius:50%;background:var(--brand-primary-tint);border:2px solid var(--brand-primary-border);overflow:hidden;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <img id="cmsAiAvatarPreview" src="@ssrSettings.AssistantAvatar" alt="Spike Assistant Avatar" style="width:100%;height:100%;object-fit:cover;" />
                  </div>
                  <div>
                    <div style="font-weight:700;font-size:0.9rem;color:var(--text-primary);">Ảnh đại diện trên Khung Chat AI</div>
                    <div id="cmsAiAvatarMeta" style="font-size:0.78rem;color:var(--text-secondary);">Hỗ trợ tải ảnh từ máy (JPG, PNG, WEBP tối đa 2 MB) hoặc chọn mẫu có sẵn</div>
                  </div>
                </div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                  <label for="cmsAiAvatarFile" class="btn btn-secondary btn-sm" style="cursor:pointer;">
                    <iconify-icon icon="lucide:upload" width="14"></iconify-icon>
                    <span>Tải ảnh từ máy</span>
                  </label>
                  <input type="file"
                         id="cmsAiAvatarFile"
                         class="sr-only"
                         accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                         onchange="handleUploadAiAvatarFile(this)" />
                  <button type="button" class="btn btn-ghost btn-sm" onclick="selectAiAvatarPreset('/assets/assistant/02_wave.png', true)">
                    Mặc định
                  </button>
                </div>
              </div>

              <div>
                <div style="font-size:0.78rem;font-weight:600;color:var(--text-secondary);margin-bottom:8px;">
                  Hoặc chọn nhanh hình đại diện có sẵn:
                </div>
                <div id="cmsAiAvatarPresets" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(64px,1fr));gap:8px;">
                  @foreach (var item in new[]
                  {
                      new { Url = "/assets/assistant/02_wave.png", Label = "Vẫy chào" },
                      new { Url = "/assets/assistant/01_idle.png", Label = "Mặc định" },
                      new { Url = "/assets/assistant/04_chat.png", Label = "Tư vấn" },
                      new { Url = "/assets/assistant/05_idea.png", Label = "Ý tưởng" },
                      new { Url = "/assets/assistant/06_jump.png", Label = "Năng động" },
                      new { Url = "/images/avatars/sunny.png", Label = "Sunny" },
                      new { Url = "/images/avatars/mochi.png", Label = "Mochi" },
                      new { Url = "/images/avatars/coco.png", Label = "Coco" }
                  })
                  {
                      bool isCurrent = string.Equals(ssrSettings.AssistantAvatar, item.Url, StringComparison.OrdinalIgnoreCase);
                      <button type="button"
                              class="cms-ai-preset-btn @(isCurrent ? "is-selected" : "")"
                              data-ai-avatar-url="@item.Url"
                              onclick="selectAiAvatarPreset('@item.Url', true)"
                              style="display:flex;flex-direction:column;align-items:center;gap:4px;padding:7px 4px;border-radius:10px;border:1.5px solid @(isCurrent ? "var(--brand-primary)" : "var(--border-default)");background:@(isCurrent ? "var(--brand-primary-tint)" : "var(--surface)");cursor:pointer;">
                        <img src="@item.Url" alt="@item.Label" style="width:38px;height:38px;border-radius:50%;object-fit:cover;" />
                        <span style="font-size:0.68rem;font-weight:600;color:var(--text-primary);">@item.Label</span>
                      </button>
                  }
                </div>
              </div>
            </div>
          </div>

          <div style="display:flex;gap:0.85rem;flex-wrap:wrap">
            <button class="btn btn-primary btn-lg" style="flex:1" onclick="handleSaveCMS()">Lưu cấu hình &amp; Áp dụng ngay</button>
            <button class="btn btn-outline btn-lg" onclick="handleResetCMS()">Khôi phục mặc định</button>
          </div>
        </div>

        <div class="card sticky-panel">
          <div class="card-header">
            <span class="card-header-title">Xem trước trực tiếp</span>
            <span class="badge badge-success">Server Sync</span>
          </div>
          <div class="card-body stack-sm">
            <div style="background:var(--surface-secondary);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:18px;color:var(--text-primary);display:flex;flex-direction:column;gap:8px">
              <span id="prevHeroTag" style="font-size:0.72rem;font-weight:650;background:var(--brand-primary-tint);color:var(--brand-primary-ink);border:1px solid var(--brand-primary-border);padding:2px 10px;border-radius:99px;align-self:flex-start">TAG</span>
              <span id="prevHeroSubtag" style="font-size:0.75rem;color:var(--brand-primary);font-weight:600">Subtag</span>
              <h4 id="prevHeroTitle" style="color:var(--text-primary);font-size:1.1rem;font-weight:700;margin:0">Tiêu đề</h4>
              <p id="prevHeroSubtitle" style="font-size:0.82rem;color:var(--text-secondary);margin:0">Mô tả...</p>
            </div>
            <div class="sh-subtle-panel" style="padding:0.9rem;display:flex;justify-content:space-between;align-items:center">
              <span class="text-xs font-semibold">Giá tiêu chuẩn / Giờ vàng:</span>
              <span class="font-bold text-mono" id="prevPrice" style="color:var(--color-primary)">@ssrStdPriceNum đ / @ssrPeakTotalNum đ</span>
            </div>
            <div class="sh-subtle-panel" style="padding:0.9rem;display:flex;justify-content:space-between;align-items:center">
              <span class="text-xs font-semibold">Khung giờ mở cửa:</span>
              <span class="font-bold text-mono" id="prevHours">@ssrSettings.OpenTime – @ssrSettings.CloseTime (Vàng từ @ssrSettings.PeakStart)</span>
            </div>
            <div class="sh-subtle-panel" style="padding:0.9rem;display:flex;flex-direction:column;gap:0.3rem">
              <h5 id="prevClubTitle" style="font-size:0.88rem;font-weight:700">Hội viên CLB</h5>
              <p id="prevClubDesc" style="font-size:0.78rem;color:var(--text-secondary)">Quyền lợi...</p>
            </div>
            <div class="sh-subtle-panel" style="padding:0.85rem;display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#247147 0%,#2E8B57 54%,#56BC6E 100%);color:#FFF;border:none;">
              <img id="prevAiAvatarImg" src="@ssrSettings.AssistantAvatar" alt="Spike Assistant" style="width:36px;height:36px;border-radius:50%;background:#EAF7EE;border:2px solid rgba(255,255,255,0.88);object-fit:cover;flex-shrink:0;" />
              <div style="display:flex;flex-direction:column;">
                <strong style="font-size:0.86rem;line-height:1.2;">Spike Assistant</strong>
                <span style="font-size:0.7rem;opacity:0.92;">Gemini AI • Dữ liệu Spike OS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

@section Scripts {
  <script src="~/js/pages/cms.js" asp-append-version="true"></script>
}
