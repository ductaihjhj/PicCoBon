@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Điều Phối Sân, POS & Sổ Cái Thu Ngân";
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Điều phối Sân, Timeline &amp; Sổ cái Thu ngân</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">
            Tách bạch đóng ca sân với ghi nhận thu tiền / hoàn tiền thực tế, đơn Pro Shop và lịch bảo trì sân.
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/Admin" class="btn btn-secondary btn-sm">
            <iconify-icon icon="lucide:layout-dashboard" width="15"></iconify-icon>
            <span>Tổng quan</span>
        </a>
        <a href="/Checkin" class="btn btn-primary btn-sm">
            <iconify-icon icon="lucide:qr-code" width="15"></iconify-icon>
            <span>Mở trạm soát vé QR</span>
        </a>
    </div>
</div>

<!-- COURT x TIME VISUAL SCHEDULING TIMELINE -->
<div class="card" style="margin-bottom:22px;">
    <div class="card-header">
        <span class="card-header-title">
            <iconify-icon icon="lucide:calendar-range" width="17" style="color:var(--brand-primary);"></iconify-icon>
            <span>Biểu đồ Lịch sân &amp; Điều phối nhanh</span>
        </span>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
            <div class="sn-matrix-legend">
                <span class="sn-matrix-legend-item" style="color:var(--status-info-text);border-color:var(--status-info-border);background:var(--status-info-bg);">■ Đang chơi</span>
                <span class="sn-matrix-legend-item" style="color:var(--brand-primary-ink);border-color:var(--brand-primary-border);background:var(--brand-primary-tint);">● Đã duyệt</span>
                <span class="sn-matrix-legend-item" style="color:var(--status-warning-text);border-color:var(--status-warning-border);background:var(--status-warning-bg);">◷ Chờ duyệt</span>
                <span class="sn-matrix-legend-item" style="color:var(--status-danger-text);border-color:var(--status-danger-border);background:var(--status-danger-bg);">✕ Bảo trì</span>
            </div>
            <input type="date" id="mgmtTimelineDate" class="form-input text-mono" style="width:auto;min-height:34px;padding:4px 10px;font-size:0.8rem;" onchange="renderManagementTimeline()" aria-label="Chọn ngày xem timeline điều phối" />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="sn-ops-timeline-wrap">
            <table class="sn-ops-timeline-table" id="mgmtTimelineGrid" aria-label="Timeline vận hành cụm sân theo giờ"></table>
        </div>
    </div>
</div>

<div class="col-main-aside">
    <div class="stack">
        <!-- 1. Pending Approval Queue -->
        <div class="card">
            <div class="card-header sh-card-header-pending">
                <span class="card-header-title">
                    <span class="badge-dot" style="background:currentColor"></span>
                    <span>Yêu cầu đặt sân chờ duyệt (<span id="pendingCount">0</span>)</span>
                </span>
                <button class="btn btn-sm btn-success" id="approveAllBtn" onclick="approveAllPending()" style="display:none">
                    <iconify-icon icon="lucide:check-check" width="14"></iconify-icon>
                    <span>Duyệt tất cả</span>
                </button>
            </div>
            <div class="card-body p-0">
                <div id="pendingList"></div>
            </div>
        </div>

        <!-- 2. Today Bookings & POS -->
        <div class="card">
            <div class="card-header" style="flex-wrap:wrap;gap:8px;">
                <span class="card-header-title">
                    <iconify-icon icon="lucide:calendar-clock" width="17" style="color:var(--brand-primary)"></iconify-icon>
                    <span>Ca thi đấu &amp; Công nợ sân</span>
                </span>
                <div class="filter-tabs" id="mgmtFilterTabs">
                    <button class="filter-tab active" onclick="setMgmtFilter('active')">Đang chơi &amp; Đã duyệt</button>
                    <button class="filter-tab" onclick="setMgmtFilter('unpaid')">Còn công nợ</button>
                    <button class="filter-tab" onclick="setMgmtFilter('completed')">Đã đóng ca</button>
                    <button class="filter-tab" onclick="setMgmtFilter('all')">Tất cả</button>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="todayList"></div>
            </div>
        </div>

        <!-- 3. Pro Shop Orders Dispatch -->
        <div class="card">
            <div class="card-header">
                <span class="card-header-title">
                    <iconify-icon icon="lucide:shopping-bag" width="17" style="color:var(--brand-primary)"></iconify-icon>
                    <span>Đơn Hàng Pro Shop (<span id="standaloneOrdersCount">0</span>)</span>
                </span>
                <span class="badge badge-neutral">Giao đồ &amp; Đối soát Sổ cái</span>
            </div>
            <div style="padding:12px 16px;border-bottom:1px solid var(--border-default);display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
                <input type="search" id="shopOrderSearch" class="form-input text-sm" style="flex:1;min-width:180px;" placeholder="Tìm mã đơn, tên khách, SĐT, mã sân..." oninput="handleShopOrderFilterChange()" aria-label="Tìm kiếm đơn hàng Pro Shop">
                <select id="shopOrderFilter" class="form-select text-sm" style="width:auto;min-width:165px;" onchange="handleShopOrderFilterChange()" aria-label="Lọc trạng thái đơn hàng Pro Shop">
                    <option value="all">Tất cả đơn hàng</option>
                    <option value="pending_fulfill">Chờ giao đồ</option>
                    <option value="delivered">Đã giao đồ</option>
                    <option value="unpaid">Chưa thu đủ</option>
                    <option value="cancelled">Đã hủy</option>
                </select>
            </div>
            <div class="card-body p-0">
                <div id="standaloneOrdersList"></div>
                <div id="shopOrdersPagination" style="padding:12px 16px;border-top:1px solid var(--border-default);display:none;"></div>
            </div>
        </div>
    </div>

    <!-- Right Column: Court Locks -->
    <div class="stack">
        <div class="card">
            <div class="card-header">
                <span class="card-header-title" style="color:var(--status-danger-text)">
                    <iconify-icon icon="lucide:wrench" width="17"></iconify-icon>
                    <span>Khóa sân bảo trì / Giải đấu</span>
                </span>
            </div>
            <div class="card-body stack-sm">
                <div class="form-group">
                    <label class="form-label">Chọn sân cần khóa:</label>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px" id="lockCourtBtns"></div>
                </div>
                <div class="form-group">
                    <label class="form-label" for="lockDate">Ngày áp dụng:</label>
                    <input class="form-input text-mono" type="date" id="lockDate">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="lockStart">Từ giờ:</label>
                        <select class="form-select" id="lockStart" onchange="onLockWindowChange()"></select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="lockDuration">Thời lượng:</label>
                        <select class="form-select" id="lockDuration" onchange="onLockDurationChange()">
                            <option value="60">1 tiếng (60p)</option>
                            <option value="120">2 tiếng (120p)</option>
                            <option value="240">4 tiếng (240p)</option>
                            <option value="full_day" id="lockDurationFullDayOption">Cả ngày hoạt động</option>
                        </select>
                    </div>
                </div>
                <div class="text-xs text-muted" id="lockWindowPreview" style="margin-top:-4px;"></div>
                <div class="form-group">
                    <label class="form-label" for="lockReason">Lý do khóa sân:</label>
                    <input class="form-input" type="text" id="lockReason" value="Bảo dưỡng mặt sân & lưới">
                </div>
                <button type="button" class="btn btn-danger btn-block" id="btnCreateCourtLock" onclick="lockCourt()">
                    <iconify-icon icon="lucide:lock" width="16"></iconify-icon>
                    <span>Áp dụng khóa sân</span>
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-header-title">
                    <iconify-icon icon="lucide:shield-alert" width="17" style="color:var(--brand-primary)"></iconify-icon>
                    <span>Sân đang khóa (<span id="activeLocksCount">0</span>)</span>
                </span>
            </div>
            <div class="card-body p-0" id="activeLocksList"></div>
        </div>
    </div>
</div>

<!-- SLIDE-OVER DETAIL DRAWER (Operations Quick Inspector) -->
<div class="sn-drawer-backdrop" id="mgmtDetailDrawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="mgmtDrawerTitle" onclick="if(event.target===this) SpikeUI.closeDrawer('mgmtDetailDrawer')">
    <aside class="sn-drawer">
        <div class="sn-drawer-header">
            <div>
                <div class="text-xs font-mono text-muted" id="mgmtDrawerSubtitle">PB-000</div>
                <h3 style="margin:2px 0 0;font-size:1.1rem;font-weight:700;" id="mgmtDrawerTitle">Chi tiết ca sân</h3>
            </div>
            <button type="button" class="modal-close" data-drawer-close onclick="SpikeUI.closeDrawer('mgmtDetailDrawer')" aria-label="Đóng chi tiết">✕</button>
        </div>
        <div class="sn-drawer-body" id="mgmtDrawerBody"></div>
        <div class="sn-drawer-footer" id="mgmtDrawerFooter"></div>
    </aside>
</div>

<!-- MODAL DUYỆT ĐƠN & QR THẬT -->
<div class="modal-overlay" id="modalQR">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 class="modal-title" style="color:var(--brand-primary)">Đã duyệt vé sân!</h3>
            <button type="button" class="modal-close" onclick="closeModal('modalQR')">✕</button>
        </div>
        <div class="modal-body" style="text-align:center;padding:18px;">
            <div class="qr-placeholder">
                <iconify-icon icon="lucide:qr-code" width="72"></iconify-icon>
                <div class="text-xs font-bold text-mono" id="qrRef"></div>
            </div>
            <div class="payment-summary mt-md" style="text-align:left">
                <div class="payment-line"><span class="text-muted">Khách hàng</span><span class="font-semibold" id="qrName"></span></div>
                <div class="payment-line"><span class="text-muted">Sân đấu</span><span class="font-semibold" id="qrCourt"></span></div>
                <div class="payment-line"><span class="text-muted">Thời gian</span><span class="font-semibold text-mono" id="qrTime"></span></div>
            </div>
        </div>
        <div class="modal-footer" style="padding:12px 18px;">
            <button type="button" class="btn btn-primary btn-block" onclick="closeModal('modalQR')">Đóng</button>
        </div>
    </div>
</div>

<!-- MODAL POS TẠI SÂN -->
<div class="modal-overlay" id="modalPOS">
    <div class="modal modal-full">
        <div class="pos-container">
            <div class="pos-menu-side">
                <div class="flex-between mb-md" style="flex-wrap:wrap;gap:8px;">
                    <div>
                        <h3 class="modal-title">Thực đơn POS tại sân (Trừ kho tức thì)</h3>
                        <p class="text-xs text-muted">Bấm vào mặt hàng còn tồn kho để thêm vào ca sân</p>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('modalPOS')">Đóng POS</button>
                </div>
                <div class="pos-menu-grid" id="posMenuGrid"></div>
            </div>
            <div class="pos-cart-side">
                <div class="pos-cart-header">
                    <span class="badge badge-success mb-sm">Hóa đơn ca sân</span>
                    <p class="font-bold text-lg" id="posCustomer"></p>
                    <p class="text-xs text-muted text-mono" id="posCourtInfo"></p>
                    <div style="display:flex;gap:6px;margin-top:8px;align-items:center;">
                        <select id="posMoveCourtSelect" class="form-select" style="padding:4px 8px;font-size:0.78rem;min-height:32px;"></select>
                        <button type="button" class="btn btn-secondary btn-xs" onclick="movePosBookingCourt()">Đổi sân</button>
                    </div>
                </div>
                <div class="pos-cart-items" id="posCartItems">
                    <div class="pos-cart-item" style="background:var(--brand-primary-tint);border-color:var(--brand-primary-border)">
                        <div class="pos-cart-item-info">
                            <div class="pos-cart-item-name" style="color:var(--brand-primary-ink)">Tiền thuê sân</div>
                            <div class="pos-cart-item-price text-mono" id="posCourtDuration"></div>
                        </div>
                        <div class="pos-qty">
                            <button type="button" onclick="adjustCourtTime(30)" title="Gia hạn thêm 30 phút">+30p</button>
                        </div>
                        <div class="pos-cart-item-total text-mono" id="posCourtFee"></div>
                    </div>
                    <div id="posCartDynamic"></div>
                </div>
                <div class="pos-cart-footer">
                    <div class="pos-total-row">
                        <span class="pos-total-label">Tổng phải thu ca sân</span>
                        <span class="pos-total-value tabular-nums" id="posTotal">0 đ</span>
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <button type="button" class="btn btn-secondary" style="flex:1" onclick="savePosDraft()">Lưu tạm</button>
                        <button type="button" class="btn btn-primary" style="flex:1.4" onclick="openBookingSettlementFromPos()">Sổ Thu Tiền / Đóng Ca</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SỔ CÁI THU TIỀN & HOÀN TIỀN (P1-04, P1-05, P1-15) -->
<div class="modal-overlay" id="modalLedgerSettlement">
    <div class="modal" style="max-width:560px;width:95%;">
        <div class="modal-header">
            <div>
                <h3 class="modal-title" id="ledgerModalTitle">Sổ Cái Thu Tiền &amp; Đối Soát</h3>
                <p class="text-xs text-muted text-mono" id="ledgerModalSubtitle"></p>
            </div>
            <button type="button" class="modal-close" onclick="closeModal('modalLedgerSettlement')">✕</button>
        </div>
        <div class="modal-body stack-sm" style="padding:18px 20px;">
            <div class="payment-summary" id="ledgerSummaryBox"></div>

            <div id="ledgerPartialFailureBanner" class="sn-alert sn-alert-warning" style="display:none;flex-direction:column;" role="alert">
                <div class="text-xs font-bold">Đã ghi sổ thu tiền thành công, nhưng chưa thể đóng ca sân!</div>
                <div class="text-xs" id="ledgerPartialFailureDetail"></div>
                <button type="button" class="btn btn-secondary btn-sm" id="btnRetryLedgerFinishOnly" onclick="retryLedgerFinishOnly()">
                    <iconify-icon icon="lucide:flag" width="14"></iconify-icon>
                    <span>Chỉ thử Đóng ca lại (KHÔNG thu tiền lại)</span>
                </button>
            </div>

            <div id="ledgerCollectSection" class="sh-subtle-panel" style="padding:14px;">
                <div class="font-bold text-sm mb-sm" style="color:var(--brand-primary-ink);">Ghi nhận bút toán Thu tiền</div>
                <div class="form-row">
                    <div class="form-group" style="margin-bottom:8px;">
                        <label class="form-label text-xs" for="ledgerPayAmount">Số tiền thực thu (VNĐ) *</label>
                        <input type="number" id="ledgerPayAmount" class="form-input text-mono font-bold" step="1000" min="1000">
                    </div>
                    <div class="form-group" style="margin-bottom:8px;">
                        <label class="form-label text-xs" for="ledgerPayMethod">Phương thức thu *</label>
                        <select id="ledgerPayMethod" class="form-select" onchange="toggleTransferRefRequirement()">
                            <option value="cash">Tiền mặt tại quầy (Cash)</option>
                            <option value="transfer">Chuyển khoản ngân hàng (Transfer)</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group" style="margin-bottom:8px;">
                        <label class="form-label text-xs" for="ledgerPayRef" id="ledgerPayRefLabel">Mã tham chiếu / UNC</label>
                        <input type="text" id="ledgerPayRef" class="form-input text-mono" placeholder="Bắt buộc nếu chuyển khoản">
                    </div>
                    <div class="form-group" style="margin-bottom:8px;">
                        <label class="form-label text-xs" for="ledgerPayNote">Ghi chú thu ngân</label>
                        <input type="text" id="ledgerPayNote" class="form-input" placeholder="VD: Thu cọc / Thu đủ tại quầy">
                    </div>
                </div>
                <label id="ledgerAlsoFinishWrap" style="display:flex;align-items:center;gap:8px;font-size:0.82rem;margin:6px 0 12px;cursor:pointer;">
                    <input type="checkbox" id="ledgerAlsoFinishSession">
                    <span>Đồng thời kết thúc ca chơi trên sân (Chuyển sang Hoàn thành)</span>
                </label>
                <button type="button" class="btn btn-primary btn-block" id="btnSubmitLedgerPay" onclick="submitLedgerPayment()">
                    <iconify-icon icon="lucide:wallet" width="16"></iconify-icon>
                    <span>Xác nhận Ghi Sổ Thu Tiền</span>
                </button>
            </div>

            <details id="ledgerRefundDetails" class="sh-refund-panel" style="display:none;">
                <summary style="cursor:pointer;font-weight:700;font-size:0.82rem;">
                    Tạo bút toán Hoàn tiền (Refund) cho khách
                </summary>
                <div style="margin-top:10px;" class="stack-sm">
                    <div class="form-row">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label text-xs" for="ledgerRefundAmount">Số tiền hoàn trả (VNĐ) *</label>
                            <input type="number" id="ledgerRefundAmount" class="form-input text-mono" step="1000" min="1000">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label text-xs" for="ledgerRefundMethod">Phương thức hoàn</label>
                            <select id="ledgerRefundMethod" class="form-select">
                                <option value="cash">Tiền mặt</option>
                                <option value="transfer">Chuyển khoản hoàn</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label text-xs" for="ledgerRefundRef">Mã giao dịch hoàn (nếu CK)</label>
                            <input type="text" id="ledgerRefundRef" class="form-input text-mono" placeholder="VD: RF-001">
                        </div>
                        <div class="form-group" style="margin-bottom:0;">
                            <label class="form-label text-xs" for="ledgerRefundReason">Lý do hoàn tiền *</label>
                            <input type="text" id="ledgerRefundReason" class="form-input" placeholder="VD: Mưa nghỉ sớm / Hủy món">
                        </div>
                    </div>
                    <button type="button" class="btn btn-danger btn-sm btn-block" onclick="submitLedgerRefund()">
                        <span>Xác nhận Ghi Sổ Hoàn Tiền</span>
                    </button>
                </div>
            </details>

            <div>
                <div class="text-xs font-bold text-muted mb-xs">Lịch sử giao dịch sổ cái</div>
                <div id="ledgerTxHistoryList" style="max-height:150px;overflow-y:auto;border:1px solid var(--border-default);border-radius:var(--radius-md);background:var(--surface);"></div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>

@section Scripts {
    <script src="~/js/management.js" asp-append-version="true"></script>
}
