@model IEnumerable<PickleballClub.Models.TbBooking>
@using PickleballClub.Utilities
@{
    ViewData["Title"] = "Tổng quan Quản trị";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    bool isStrictAdmin = Function.IsAdmin();
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Trung tâm Điều hành Cụm sân</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">
            Theo dõi nhanh số liệu vận hành, lịch đặt chờ duyệt, thu ngân POS và kiểm soát vé QR.
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <a href="/Management" class="btn btn-primary btn-sm">
            <iconify-icon icon="lucide:calendar-range" width="16"></iconify-icon>
            <span>Điều phối Sân &amp; POS</span>
        </a>
        <a href="/Checkin" class="btn btn-secondary btn-sm">
            <iconify-icon icon="lucide:qr-code" width="16"></iconify-icon>
            <span>Trạm soát vé QR</span>
        </a>
    </div>
</div>

<div class="stack" style="gap:24px;">
    <!-- KPI Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-card-top">
                <span class="stat-card-label">Cụm sân hoạt động</span>
                <div class="stat-card-icon" style="background:var(--brand-primary-tint);color:var(--brand-primary);">
                    <iconify-icon icon="lucide:map-pin" width="18"></iconify-icon>
                </div>
            </div>
            <div class="stat-card-value text-mono tabular-nums">@ViewBag.TotalCourts sân</div>
            <div class="stat-card-meta">Mặt sân Acrylic Cushion 8 lớp</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-top">
                <span class="stat-card-label">Tổng đơn đặt sân</span>
                <div class="stat-card-icon" style="background:var(--status-info-bg);color:var(--status-info-text);">
                    <iconify-icon icon="lucide:calendar-check-2" width="18"></iconify-icon>
                </div>
            </div>
            <div class="stat-card-value text-mono tabular-nums">@ViewBag.TotalBookings đơn</div>
            <div class="stat-card-meta">Chờ duyệt: <strong>@ViewBag.PendingBookings</strong> đơn</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-top">
                <span class="stat-card-label">Mặt hàng Pro Shop</span>
                <div class="stat-card-icon" style="background:var(--status-success-bg);color:var(--status-success-text);">
                    <iconify-icon icon="lucide:shopping-bag" width="18"></iconify-icon>
                </div>
            </div>
            <div class="stat-card-value text-mono tabular-nums">@ViewBag.TotalProducts món</div>
            <div class="stat-card-meta">Giải khát, đồ ăn &amp; phụ kiện</div>
        </div>

        <div class="stat-card">
            <div class="stat-card-top">
                <span class="stat-card-label">Thực thu ròng Sổ cái</span>
                <div class="stat-card-icon" style="background:var(--status-warning-bg);color:var(--status-warning-text);">
                    <iconify-icon icon="lucide:wallet" width="18"></iconify-icon>
                </div>
            </div>
            <div class="stat-card-value text-mono tabular-nums" style="color:var(--brand-primary);">@string.Format("{0:N0} đ", ViewBag.TotalRevenue ?? 0)</div>
            <div class="stat-card-meta">Công nợ chưa thu: <strong>@string.Format("{0:N0} đ", ViewBag.EstimatedReceivables ?? 0)</strong></div>
        </div>
    </div>

    <!-- Operational Modules Launchpad -->
    <div class="card">
        <div class="card-header">
            <span class="card-header-title">
                <iconify-icon icon="lucide:layout-grid" width="17" style="color:var(--brand-primary)"></iconify-icon>
                <span>Phân hệ vận hành chính</span>
            </span>
            <span class="badge badge-success">Hoạt động trực tuyến</span>
        </div>
        <div class="card-body">
            <div class="match-grid" style="grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;">
                <a href="/Management" class="sh-module-card">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <iconify-icon icon="lucide:calendar-range" width="22" style="color:var(--brand-primary);"></iconify-icon>
                        <span class="badge badge-primary">Vận hành</span>
                    </div>
                    <h3 style="margin:0 0 6px;font-size:1rem;">Điều phối &amp; Sổ cái POS</h3>
                    <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Timeline lịch sân, duyệt vé, gọi đồ POS, thu tiền và khóa sân bảo trì.</p>
                </a>

                <a href="/Checkin" class="sh-module-card">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <iconify-icon icon="lucide:qr-code" width="22" style="color:var(--status-info-text);"></iconify-icon>
                        <span class="badge badge-info">Check-in</span>
                    </div>
                    <h3 style="margin:0 0 6px;font-size:1rem;">Trạm soát vé QR</h3>
                    <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Quét camera hoặc tải ảnh QR ZXing để nhận sân vào ca nhanh chóng.</p>
                </a>

                <a href="/Admin/Bookings" class="sh-module-card">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <iconify-icon icon="lucide:calendar-check-2" width="22" style="color:var(--status-success-text);"></iconify-icon>
                        <span class="badge badge-success">Đơn sân</span>
                    </div>
                    <h3 style="margin:0 0 6px;font-size:1rem;">Quản lý đơn đặt sân</h3>
                    <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Tạo đơn Walk-in tại quầy, tra cứu danh sách đặt sân và đối soát thanh toán.</p>
                </a>

                @if (isStrictAdmin)
                {
                    <a href="/Reports" class="sh-module-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                            <iconify-icon icon="lucide:bar-chart-3" width="22" style="color:var(--status-warning-text);"></iconify-icon>
                            <span class="badge badge-warning">Tài chính</span>
                        </div>
                        <h3 style="margin:0 0 6px;font-size:1rem;">Báo cáo &amp; Sổ cái</h3>
                        <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Biểu đồ doanh thu theo ngày, khách hàng thân thiết và nhật ký giao dịch.</p>
                    </a>

                    <a href="/Admin/Products" class="sh-module-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                            <iconify-icon icon="lucide:shopping-bag" width="22" style="color:var(--brand-primary);"></iconify-icon>
                            <span class="badge badge-neutral">Pro Shop</span>
                        </div>
                        <h3 style="margin:0 0 6px;font-size:1rem;">Sản phẩm &amp; Tồn kho</h3>
                        <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Quản lý SKU, cập nhật đơn giá, ảnh sản phẩm và kiểm soát tồn kho thực tế.</p>
                    </a>

                    <a href="/Cms" class="sh-module-card">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                            <iconify-icon icon="lucide:settings-2" width="22" style="color:var(--text-secondary);"></iconify-icon>
                            <span class="badge badge-neutral">Cấu hình</span>
                        </div>
                        <h3 style="margin:0 0 6px;font-size:1rem;">Cấu hình CLB &amp; Giá</h3>
                        <p style="margin:0;font-size:0.84rem;color:var(--text-secondary);">Thiết lập khung giờ mở cửa, đơn giá tiêu chuẩn, giờ vàng và nội dung trang chủ.</p>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
