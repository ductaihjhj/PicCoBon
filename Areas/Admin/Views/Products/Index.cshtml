@model IEnumerable<PickleballClub.Models.TbProduct>

@{
    ViewData["Title"] = "Quản lý Sản phẩm & Dịch vụ POS";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Quản lý Sản phẩm & Dịch vụ POS</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin">Quản trị</a></li>
                        <li class="breadcrumb-item active">Sản phẩm POS</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><a asp-action="Create" class="btn btn-success btn-sm">+ Thêm sản phẩm mới</a></h3>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table table-hover text-nowrap">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Danh mục</th>
                                        <th>Đơn giá</th>
                                        <th>Mô tả</th>
                                        <th>Tồn kho</th>
                                        <th>Hiển thị</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 1; }
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@(i++)</td>
                                            <td class="font-weight-bold">@item.Title</td>
                                            <td>@(item.CategoryProduct?.Title ?? "-")</td>
                                            <td class="text-success font-weight-bold">@string.Format("{0:N0} đ", item.Price)</td>
                                            <td>@item.Description</td>
                                            <td>@item.Quantity</td>
                                            <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-primary btn-sm">Sửa</a>
                                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">Xoá</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
