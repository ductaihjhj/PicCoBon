@model IEnumerable<PickleballClub.Models.TbProduct>
@using PickleballClub.Services

@{
    ViewData["Title"] = "Quản lý sản phẩm Pro Shop";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="sn-page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:14px;padding-bottom:18px;margin-bottom:22px;border-bottom:1px solid var(--border-default);">
    <div>
        <h1 class="sn-h1" style="margin:0;font-size:1.65rem;font-weight:700;">Quản lý sản phẩm Pro Shop &amp; POS</h1>
        <p style="margin:5px 0 0;color:var(--text-secondary);font-size:0.9rem;">Quản lý ảnh packshot, đơn giá và tồn kho đồng bộ trực tiếp với Pro Shop &amp; quầy POS.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm" data-testid="admin-btn-create-product">
        <iconify-icon icon="lucide:plus" width="15"></iconify-icon>
        <span>Thêm sản phẩm mới</span>
    </a>
</div>

            @if (TempData["SuccessMessage"] is string successMsg && !string.IsNullOrWhiteSpace(successMsg))
            {
                <div class="sn-alert sn-alert-success" style="margin-bottom:16px;" role="alert" data-testid="admin-product-alert-success">
                    <iconify-icon icon="lucide:check-circle-2" width="16"></iconify-icon>
                    <span>@successMsg</span>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Danh mục mặt hàng Pro Shop (@Model.Count() sản phẩm)</h3>
                </div>
                <div class="sn-table-wrap">
                    <table class="sn-table" data-testid="admin-products-table">
                        <thead>
                            <tr>
                                <th style="width: 60px;">ID</th>
                                <th style="width: 110px;">Ảnh SP</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th>Giá bán</th>
                                <th>Tồn kho</th>
                                <th>Trạng thái</th>
                                <th style="width: 150px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var item in Model)
                            {
                                var categoryAlias = item.CategoryProduct?.Alias ?? "other";
                                var resolvedImg = ProductImageService.NormalizeProductImageUrl(item.Image, categoryAlias);
                                var hasCustomImg = ProductImageService.HasCustomProductImage(item.Image);
                                var stock = item.UnitInStock ?? item.Quantity ?? 0;
                                <tr data-product-row-id="@item.ProductId">
                                    <td class="align-middle text-muted font-weight-bold">#@(i++)</td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div style="width:56px;height:56px;border-radius:10px;background:#FFFFFF;border:1px solid var(--border-color);padding:4px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;">
                                                <img src="@resolvedImg"
                                                     alt="@item.Title"
                                                     width="48"
                                                     height="48"
                                                     loading="lazy"
                                                     decoding="async"
                                                     data-testid="admin-product-thumb-@item.ProductId"
                                                     style="width:100%;height:100%;object-fit:contain;"
                                                     onerror="this.onerror=null;this.src='/assets/products/placeholder-default.svg';" />
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="font-weight-bold text-dark">@item.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 280px;">@item.Description</div>
                                        }
                                        <div class="mt-1">
                                            @if (hasCustomImg)
                                            {
                                                <span class="badge badge-info" style="font-size:11px;">Ảnh sản phẩm</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light border" style="font-size:11px;">Ảnh mặc định</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="align-middle">@(item.CategoryProduct?.Title ?? "Chưa phân loại")</td>
                                    <td class="align-middle text-danger font-weight-bold text-mono text-nowrap">@string.Format("{0:N0} đ", item.Price ?? 0)</td>
                                    <td class="align-middle text-nowrap">
                                        @if (stock <= 0)
                                        {
                                            <span class="badge badge-danger">Hết hàng (0)</span>
                                        }
                                        else if (stock <= 5)
                                        {
                                            <span class="badge badge-warning">Sắp hết (@stock)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">Còn @stock</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success">Đang bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Ngừng bán</span>
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-xs btn-secondary" data-testid="admin-edit-product-@item.ProductId">
                                                <iconify-icon icon="lucide:pencil" width="13"></iconify-icon>
                                                <span>Sửa</span>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-xs btn-danger" data-testid="admin-delete-product-@item.ProductId">
                                                <iconify-icon icon="lucide:trash-2" width="13"></iconify-icon>
                                                <span>Xoá</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
