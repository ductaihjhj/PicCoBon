@model PickleballClub.Models.TbProduct

@{
    ViewData["Title"] = "Xoá sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Xoá sản phẩm</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">Xác nhận xoá sản phẩm</h3>
                </div>
                <div class="card-body">
                    <p><strong>Tên sản phẩm:</strong> @Model.Title</p>
                    <p><strong>Đơn giá:</strong> @string.Format("{0:N0} đ", Model.Price)</p>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="ProductId" />
                        <input type="submit" value="Xoá" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    </form>
                </div>
            </div>
        </div>
    </section>
</div>
