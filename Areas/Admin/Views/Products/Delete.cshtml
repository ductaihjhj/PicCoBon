@model PickleballClub.Models.TbProduct
@using PickleballClub.Services
@{
    ViewData["Title"] = "Xoá sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var resolvedImg = ProductImageService.NormalizeProductImageUrl(Model.Image, Model.CategoryProduct?.Alias);
    ViewData["AdminHeaderTitle"] = $"Xoá sản phẩm #{Model.ProductId}";
    ViewData["AdminHeaderBackUrl"] = "/Admin/Products";
}

@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_AdminPageHeader.cshtml")

<div class="card card-danger" style="max-width:600px;">
    <div class="card-header">
        <h3 class="card-title">Xác nhận xoá sản phẩm khỏi danh mục Pro Shop</h3>
    </div>
    <div class="card-body">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:18px;">
            <div style="width:84px;height:84px;border-radius:10px;background:var(--surface-subtle);border:1px solid var(--border-default);padding:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <img src="@resolvedImg"
                     alt="@Model.Title"
                     width="68"
                     height="68"
                     style="width:100%;height:100%;object-fit:contain;"
                     onerror="this.onerror=null;this.src='/assets/products/placeholder-default.svg';" />
            </div>
            <div>
                <h4 style="margin:0 0 4px;font-size:1.05rem;font-weight:700;">@Model.Title</h4>
                <p style="margin:0 0 4px;color:var(--text-secondary);font-size:0.875rem;">Danh mục: <strong>@(Model.CategoryProduct?.Title ?? "Chưa phân loại")</strong></p>
                <p style="margin:0;color:var(--status-danger-text);font-weight:650;font-size:0.875rem;" class="text-mono tabular-nums">
                    Đơn giá: @string.Format("{0:N0} đ", Model.Price ?? 0) · Tồn kho: @(Model.UnitInStock ?? Model.Quantity ?? 0)
                </p>
            </div>
        </div>
        <form asp-action="Delete" style="display:flex;gap:8px;">
            <input type="hidden" asp-for="ProductId" />
            <input type="submit" value="Xác nhận xoá" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>
