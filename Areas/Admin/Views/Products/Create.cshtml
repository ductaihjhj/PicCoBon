@model PickleballClub.Models.ProductFormViewModel
@using PickleballClub.Services

@{
    ViewData["Title"] = "Thêm mới sản phẩm Pro Shop";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var placeholderUrl = ProductImageService.GetCategoryPlaceholderUrl("drink");
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2 align-items-center">
                <div class="col-sm-6">
                    <h1 class="m-0 font-weight-bold">Thêm mới sản phẩm Pro Shop</h1>
                    <small class="text-muted">Tải ảnh sản phẩm chất lượng cao (PNG, JPG, WebP) để hiển thị trên Pro Shop &amp; POS.</small>
                </div>
                <div class="col-sm-6 text-sm-right mt-2 mt-sm-0">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="adminProductForm" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <!-- Left Column: Product Details -->
                    <div class="col-lg-7">
                        <div class="card card-primary card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title font-weight-bold">Thông tin sản phẩm</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="Title" class="font-weight-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                                    <input asp-for="Title" class="form-control" placeholder="VD: Nước khoáng thể thao Revive 500ml" required />
                                    <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label asp-for="CategoryProductId" class="font-weight-bold">Danh mục <span class="text-danger">*</span></label>
                                        <select asp-for="CategoryProductId" class="form-control" asp-items="ViewBag.CategoryProductId"></select>
                                        <span asp-validation-for="CategoryProductId" class="text-danger small d-block mt-1"></span>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label asp-for="Price" class="font-weight-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                        <input asp-for="Price" type="number" min="1000" step="1000" class="form-control" placeholder="VD: 20000" required />
                                        <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label asp-for="UnitInStock" class="font-weight-bold">Số lượng tồn kho <span class="text-danger">*</span></label>
                                        <input asp-for="UnitInStock" type="number" min="0" step="1" class="form-control" required />
                                        <span asp-validation-for="UnitInStock" class="text-danger small d-block mt-1"></span>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label asp-for="Icon" class="font-weight-bold">Icon phụ trợ (Badge / Fallback)</label>
                                        <input asp-for="Icon" class="form-control" placeholder="VD: mdi:cup-water" />
                                        <small class="form-text text-muted">Chỉ dùng cho nhãn phụ; hình đại diện chính sử dụng ảnh tải lên.</small>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Description" class="font-weight-bold">Mô tả ngắn</label>
                                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="VD: Bù nước & điện giải tức thì trên sân"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="form-group mb-0">
                                    <div class="custom-control custom-switch">
                                        <input type="checkbox" class="custom-control-input" asp-for="IsActive" id="switchIsActive" />
                                        <label class="custom-control-label font-weight-bold" for="switchIsActive">Hiển thị mở bán trên Pro Shop &amp; POS</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Product Image Upload & Live Preview -->
                    <div class="col-lg-5">
                        <div class="card card-info card-outline shadow-sm">
                            <div class="card-header">
                                <h3 class="card-title font-weight-bold">Hình ảnh sản phẩm (1:1 Studio Stage)</h3>
                            </div>
                            <div class="card-body">
                                <div class="text-center mb-3">
                                    <div id="productPreviewStage"
                                         style="width:220px;height:220px;margin:0 auto;border-radius:16px;background:radial-gradient(circle at 50% 35%, #FFFFFF 0%, #F1F5F9 100%);border:2px solid #E2E8F0;padding:16px;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;">
                                        <img id="productImagePreviewImg"
                                             src="@placeholderUrl"
                                             alt="Xem trước ảnh sản phẩm"
                                             data-default-src="@placeholderUrl"
                                             style="width:100%;height:100%;object-fit:contain;transition:transform 0.2s ease;" />
                                    </div>
                                    <div id="productImageMeta" class="small text-muted mt-2">
                                        Chưa chọn ảnh riêng — hệ thống sẽ hiển thị ảnh minh họa theo danh mục.
                                    </div>
                                </div>

                                <div id="productImageDropzone"
                                     tabindex="0"
                                     role="button"
                                     aria-label="Kéo thả ảnh sản phẩm vào đây hoặc bấm để chọn file"
                                     style="border:2px dashed #94A3B8;border-radius:12px;padding:18px 14px;text-align:center;background:#F8FAFC;cursor:pointer;transition:all 0.2s ease;">
                                    <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                    <div class="font-weight-bold text-dark">Kéo &amp; thả ảnh vào đây hoặc <span class="text-primary" style="text-decoration:underline;">bấm chọn file</span></div>
                                    <div class="small text-muted mt-1">
                                        Hỗ trợ <strong>PNG, JPG/JPEG, WebP</strong> · Tối đa <strong>5 MB</strong> · Khuyến nghị tỷ lệ <strong>1:1</strong> (tối thiểu 400×400px)
                                    </div>
                                    <input asp-for="ImageFile"
                                           type="file"
                                           id="productImageInput"
                                           accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
                                           class="d-none"
                                           data-testid="admin-product-image-input" />
                                </div>

                                <span asp-validation-for="ImageFile" id="productImageClientError" class="text-danger small font-weight-bold d-block mt-2"></span>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnChooseImageFile">
                                        <i class="fas fa-folder-open mr-1"></i> Chọn ảnh từ máy
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnClearSelectedImage">
                                        <i class="fas fa-undo mr-1"></i> Bỏ ảnh vừa chọn
                                    </button>
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-end" style="gap: 8px;">
                                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                                <button type="submit" class="btn btn-primary font-weight-bold" data-testid="admin-product-submit">
                                    <i class="fas fa-save mr-1"></i> Lưu sản phẩm
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            const dropzone = document.getElementById('productImageDropzone');
            const fileInput = document.getElementById('productImageInput');
            const previewImg = document.getElementById('productImagePreviewImg');
            const metaEl = document.getElementById('productImageMeta');
            const errEl = document.getElementById('productImageClientError');
            const btnChoose = document.getElementById('btnChooseImageFile');
            const btnClear = document.getElementById('btnClearSelectedImage');
            const maxBytes = 5 * 1024 * 1024;
            const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
            const allowedExts = ['.png', '.jpg', '.jpeg', '.webp'];
            let objectUrl = null;

            function cleanupUrl() {
                if (objectUrl) {
                    URL.revokeObjectURL(objectUrl);
                    objectUrl = null;
                }
            }

            function validateAndPreview(file) {
                errEl.textContent = '';
                if (!file) return;

                const lowerName = (file.name || '').toLowerCase();
                const hasValidExt = allowedExts.some(ext => lowerName.endsWith(ext));
                const hasValidMime = allowedTypes.includes((file.type || '').toLowerCase());

                if (!hasValidExt || !hasValidMime) {
                    errEl.textContent = 'Định dạng không hợp lệ. Chỉ chấp nhận ảnh PNG, JPG/JPEG hoặc WebP.';
                    fileInput.value = '';
                    return;
                }

                if (file.size > maxBytes) {
                    errEl.textContent = 'Dung lượng ảnh vượt quá 5 MB (' + (file.size / (1024 * 1024)).toFixed(2) + ' MB).';
                    fileInput.value = '';
                    return;
                }

                cleanupUrl();
                objectUrl = URL.createObjectURL(file);
                previewImg.src = objectUrl;
                const kb = (file.size / 1024).toFixed(1);
                metaEl.textContent = 'Ảnh mới: ' + file.name + ' (' + kb + ' KB)';
                btnClear.classList.remove('d-none');
            }

            dropzone.addEventListener('click', () => fileInput.click());
            dropzone.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    fileInput.click();
                }
            });
            btnChoose.addEventListener('click', () => fileInput.click());

            fileInput.addEventListener('change', () => {
                if (fileInput.files && fileInput.files[0]) {
                    validateAndPreview(fileInput.files[0]);
                }
            });

            btnClear.addEventListener('click', () => {
                cleanupUrl();
                fileInput.value = '';
                errEl.textContent = '';
                previewImg.src = previewImg.getAttribute('data-default-src');
                metaEl.textContent = 'Chưa chọn ảnh riêng — hệ thống sẽ hiển thị ảnh minh họa theo danh mục.';
                btnClear.classList.add('d-none');
            });

            ['dragenter', 'dragover'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = '#007BFF';
                    dropzone.style.background = '#EFF6FF';
                });
            });

            ['dragleave', 'drop'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.style.borderColor = '#94A3B8';
                    dropzone.style.background = '#F8FAFC';
                });
            });

            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                if (dt && dt.files && dt.files.length > 0) {
                    fileInput.files = dt.files;
                    validateAndPreview(dt.files[0]);
                }
            });
        })();
    </script>
}
